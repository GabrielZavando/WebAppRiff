# Docker context exclusions — monorepo root (context for all app Dockerfiles).
# Keeps the build context small and prevents secrets/build artifacts from
# travelling to the Docker daemon.
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
.git/
.env
.env.*
!.env.example
*.local
*.tsbuildinfo
**/*.tsbuildinfo
apps/web/.astro/
apps/web/test-results/
apps/admin/.angular/
# Generated at build time from build args (apps/admin/Dockerfile runs
# scripts/write-env.mjs). Keeping it out of the context (1) prevents real
# credentials from a dev machine from being baked into images and (2) makes
# local builds identical to a clean checkout (Coolify/CI).
apps/admin/src/environments/environment.production.ts
apps/admin/src/favicon/
apps/admin/src/environments/environment.development.local.ts
