# =============================================================================
# Environment Variables Template — Riff Catálogo Digital Headless
# Copy this file to .env and fill in the values
# =============================================================================
# ⚠️ NEVER commit .env with real values to version control
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

NODE_ENV=development
PORT=3000
# Backend (NestJS) base URL. Contract: it MUST include the /api/v1 suffix —
# the web data clients build `${base}/products`, etc. on top of it. A value
# without the suffix is auto-corrected by resolveApiBaseUrl() (apiBaseUrl.ts),
# but always set it with the suffix to keep environments explicit.
NESTJS_API_URL=http://localhost:3000/api/v1
# Public URL of the Astro site (canonical URLs, sitemap). MUST be the real
# domain in production builds — never leave it pointing at localhost.
SITE_URL=http://localhost:4321
# When set to "true", an Astro production build FAILS if the API is
# unreachable or the product catalog comes back empty (no silent empty
# catalog publishing). Leave unset in dev; production builds set REQUIRE_API=true.
REQUIRE_API=
ASTRO_SITE_URL=http://localhost:4321
ANGULAR_ADMIN_URL=http://localhost:4200

# =============================================================================
# FIREBASE (Firestore + Auth + Storage)
# =============================================================================
# El runtime del backend autentica contra Firebase Admin usando Application
# Default Credentials (ADC): en Cloud Run resuelve la service account de runtime
# del servicio automáticamente; en local se obtiene con
#   gcloud auth application-default login
# (o exportando GOOGLE_APPLICATION_CREDENTIALS=<path al JSON>).
# El runtime SOLO requiere estas dos variables:

FIREBASE_PROJECT_ID=riff-catalogo
FIREBASE_STORAGE_BUCKET=webappriff.firebasestorage.app

# -----------------------------------------------------------------------------
# Credenciales de service account (SOLO el CLI raw migrate:firestore)
# -----------------------------------------------------------------------------
# FIREBASE_CLIENT_EMAIL y FIREBASE_PRIVATE_KEY NO se usan en runtime ni en los
# CLIs de NestJS (seed/migrate-imagenes/bootstrap/normalize-descriptions), que
# autentican con ADC igual que el runtime (ver arriba). Solo `migrate-firestore`
# (script raw fuera de NestJS) las consume, conectando origen y destino con un
# service account JSON explícito.
# Mapeá los campos del JSON descargado a estas variables:
#   client_email  -> FIREBASE_CLIENT_EMAIL
#   private_key   -> FIREBASE_PRIVATE_KEY
# IMPORTANTE: el private_key del JSON viene con saltos escapados como "\n".
# Pegalo EXACTAMENTE igual (con los "\n" literales). `migrate-firestore` lo
# normaliza a saltos de línea reales. Usá comillas simples en .env si tu shell
# las necesita.

FIREBASE_CLIENT_EMAIL=firebase-adminsdk@riff-catalogo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nXXX...\n-----END PRIVATE KEY-----\n'

# =============================================================================
# BOOTSTRAP SUPERADMIN (comando CLI del backend)
# =============================================================================
# Solo se usa UNA vez para crear el primer usuario superadmin (no hay nadie que
# se autentique para usar POST /users). Ejecutá desde apps/backend:
#   BOOTSTRAP_SUPERADMIN_EMAIL=admin@riff.cl \
#   BOOTSTRAP_SUPERADMIN_PASSWORD='cambiame123' \
#   npm run bootstrap:superadmin
# El comando es idempotente (re-ejecutarlo no crea duplicados).
BOOTSTRAP_SUPERADMIN_EMAIL=admin@riff.cl
BOOTSTRAP_SUPERADMIN_PASSWORD='cambiame123'
# Opcional: si no se setea, se usa la parte local del email como nombre.
# BOOTSTRAP_SUPERADMIN_NAME=Administrador

# =============================================================================
# DEPLOY (Coolify / VPS)
# =============================================================================

DOCKER_REGISTRY=ghcr.io/riff
COOLIFY_API_TOKEN=coolify_xxx
SLACK_WEBHOOK_URL=
# URL of the webhook the backend fires when any public catalog entity changes
# (category, subcategory, product) so Coolify rebuilds the static Astro site.
# Sent as a fire-and-forget POST with `Authorization: Bearer <TOKEN>` and a 5s
# timeout. No-op when unset. Managed as NestJS secrets in Secret Manager (ops).
CATALOG_REBUILD_WEBHOOK_URL=
CATALOG_REBUILD_WEBHOOK_TOKEN=
