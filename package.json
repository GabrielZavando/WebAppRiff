{
  "name": "riff-catalogo-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Riff Catálogo Digital Headless — Mono-repo con NestJS (BFF), Astro (sitio público SSG) y Angular (panel admin)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm ci",
    "postinstall": "node scripts/build-html-sanitize.mjs",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run start --workspace=apps/admin",
    "test:smoke": "npm run test:smoke --workspaces",
    "smoke:api": "node scripts/smoke/api.mjs",
    "smoke:web": "node scripts/smoke/web.mjs",
    "smoke:admin": "node scripts/smoke/admin.mjs",
    "audit": "node scripts/audit.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.3.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@gabrielzavando/specboot": "^0.9.0",
    "husky": "^9.0.0",
    "vitest": "^4.1.10"
  }
}
