{
  "name": "@riff/html-sanitize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared HTML sanitization policy for Riff (sanitize-rich-html + strip-to-text). Used by backend (write path, CommonJS) and frontend (render path, ESM via Vite).",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('fs').renameSync('dist/index.js','dist/index.cjs')\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sanitize-html": "^2.13.1",
    "he": "^1.2.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "@types/he": "^1.2.3",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
