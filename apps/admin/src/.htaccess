# LiteSpeed/cPanel contract for the Angular admin panel.
#
# Mirror of apps/admin/nginx.conf for the shared hosting, where nginx is not
# available and `.htaccess` is the source of truth for the header and cache
# contract. The panel is a SPA: unknown routes fall back to index.html so
# client-side routing works on deep links.
#
# The cache policy follows the real layout of the production build: the hashed
# bundles (chunk-*.js, styles-*.css) live in the root of the output and the
# hashed fonts under media/. The nginx.conf only covers /assets/*, so this
# contract caches strictly more than the container lane.
#
# Deliberately absent:
# - the `Options` directive: it is the usual cause of a 500 when the hosting
#   forbids it through AllowOverride (the error log reports it);
# - `Header ... env=` with `SetEnvIf`: the cache scope is resolved by file
#   extension instead.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https: data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# Hashed bundles and fonts: immutable cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html (SPA bootstrap) and any document served through the fallback.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Canonical HTTPS: 301 from HTTP to HTTPS, evaluated BEFORE the SPA fallback so
# a deep link over HTTP is redirected instead of being served as index.html.
# The redirect lives in the repository because a redirect configured in the
# cPanel panel would be lost every time this file is deployed over the hosting
# account.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # The ACME challenge path stays on HTTP so certificate renewal keeps working.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# SPA fallback: any internal route serves index.html so client routing works.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
