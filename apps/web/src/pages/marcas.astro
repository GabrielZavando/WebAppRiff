---
import Layout from '@/layouts/Layout.astro';
// /marcas: no catalog search (showSearch={false}) + a placeholder <main>.
// The page content is scoped for a later change; this commit establishes the
// route shell (Header + Footer via Layout) so the navigation link resolves.
---

<Layout title="Marcas — Riff" showSearch={false}>
  <main class="flex-grow">
    <section class="mx-auto min-h-[60vh] max-w-[1200px] px-4 py-12">
      <h1 class="mb-4 font-heading text-3xl font-bold text-secondary">Marcas</h1>
      <p class="text-text-2">El contenido de la página de marcas está en construcción.</p>
    </section>
  </main>
</Layout>
