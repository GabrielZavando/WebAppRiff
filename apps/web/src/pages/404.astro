---
import Layout from '@/layouts/Layout.astro';
---

<!--
  Public 404 page. Astro generates `dist/404.html` from this file, and the
  `.htaccess` of the shared hosting maps the 404 error to it
  (`ErrorDocument 404 /404.html`), mirroring `error_page 404 /404.html` in
  apps/web/nginx.conf (change hosting-litespeed-htaccess).

  Minimal page on purpose: it reuses the site layout (header, footer and
  design tokens) and offers a single way back to the home page.
-->
<Layout
  title="Página no encontrada — Riff"
  description="La página solicitada no existe o fue movida. Vuelve al inicio del catálogo de Riff."
  hero={false}
  showSearch={false}
>
  <main class="flex flex-grow items-center justify-center bg-neutral-50 py-16">
    <div
      class="flex w-full max-w-2xl flex-col items-center gap-6 border border-border bg-white p-10 text-center shadow-1"
    >
      <p class="text-5xl font-bold text-primary-dark">404</p>
      <h1 class="text-2xl font-semibold text-text">Página no encontrada</h1>
      <p class="text-base text-text-muted">
        La página que buscas no existe o cambió de dirección. Puedes volver al
        inicio o explorar nuestro catálogo de productos.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
