---
import Layout from '@/layouts/Layout.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import PanelHome from '@/components/PanelHome.astro';
import SolutionSection from '@/components/SolutionSection.astro';
import ServicesSection from '@/components/ServicesSection.astro';
import DestacadosSection from '@/components/DestacadosSection.astro';
import PilaresSection from '@/components/PilaresSection.astro';
import NosotrosTeamSection from '@/components/NosotrosTeamSection.astro';
import { HERO_BANNER_CONTENT } from '@/lib/config/hero-banner';
import { PANEL_HOME_CONTENT } from '@/lib/config/panel-home';
import { SOLUTION_SECTION_CONTENT } from '@/lib/config/solution-section';
import { SERVICES_SECTION_CONTENT } from '@/lib/config/services-section';
import { DESTACADOS_SECTION_CONTENT } from '@/lib/config/destacados-section';
import { PILARES_SECTION_CONTENT } from '@/lib/config/pilares-section';
import { NOSOTROS_TEAM_SECTION_CONTENT } from '@/lib/config/nosotros-team-section';
import { getFeaturedProducts } from '@/lib/api/products';
import { toFeaturedProduct } from '@/lib/products/toFeaturedProduct';

/**
 * "Soluciones Destacadas" is panel-driven: the cards are the backend products
 * flagged `destacado: true` (published catalog), fetched at build time and
 * capped visually to the first 8 in backend order — the slice happens in the
 * page, before the props, so the section never renders more than 8 cards.
 */
const featured = (await getFeaturedProducts())
  .slice(0, 8)
  .map(toFeaturedProduct);
---

<Layout title="Riff Catálogo Digital" hero>
  <HeroBanner {...HERO_BANNER_CONTENT} />
  <PanelHome {...PANEL_HOME_CONTENT} />
  <SolutionSection {...SOLUTION_SECTION_CONTENT} />
  <ServicesSection {...SERVICES_SECTION_CONTENT} />
  <DestacadosSection
    headline={DESTACADOS_SECTION_CONTENT.headline}
    ctaText={DESTACADOS_SECTION_CONTENT.ctaText}
    ctaHref={DESTACADOS_SECTION_CONTENT.ctaHref}
    products={featured}
  />
  <PilaresSection {...PILARES_SECTION_CONTENT} />
  <NosotrosTeamSection {...NOSOTROS_TEAM_SECTION_CONTENT} />
</Layout>