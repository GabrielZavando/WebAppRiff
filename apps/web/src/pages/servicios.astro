---
import Layout from '@/layouts/Layout.astro';
import ServicesHero from '@/components/ServicesHero.astro';
import ServiciosPortafolioSection from '@/components/ServiciosPortafolioSection.astro';
import ServiciosTerrenoSection from '@/components/ServiciosTerrenoSection.astro';
import tratamientoAgua from '@/assets/img/tratamiento-agua.webp';
import { SERVICIOS_PAGE_CONTENT } from '@/lib/config/services-page';
---

<!--
  Public services page (/servicios). Composes the transparent ServicesHero (no
  own background) with two sections fed by SERVICIOS_PAGE_CONTENT (dumb
  components + hardcoded config, site-wide pattern):
  1. Portafolio Técnico: four technical solution rows with specs and tags.
  2. Servicios en Terreno: four alternating service rows with images.
  The page passes the hero flag to Layout so the full-bleed hero image is
  rendered with the color overlay; heroImage overrides the default home image
  with tratamiento-agua.webp (design.md D1). The transparent header and search
  bar become solid on scroll, exactly like the home page. Section 1 sits on the
  neutral bg surface and section 2 on primary-100 to create rhythm without
  shadows (design.md D8).
-->
<Layout
  title="Servicios — Riff"
  description="Servicios especializados de Riff en medición, control y tratamiento de fluidos: edificios, industria, obras y plantas de agua."
  hero
  heroImage={tratamientoAgua}
>
  <main class="flex-grow">
    <ServicesHero {...SERVICIOS_PAGE_CONTENT.hero} />
    <ServiciosPortafolioSection {...SERVICIOS_PAGE_CONTENT.portfolioSection} />
    <ServiciosTerrenoSection {...SERVICIOS_PAGE_CONTENT.fieldServicesSection} />
  </main>
</Layout>
