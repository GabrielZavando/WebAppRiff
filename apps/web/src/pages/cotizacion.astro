---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Solicitar cotización — Riff">
  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-xl">
      <h1 class="text-3xl font-bold text-secondary mb-4">Solicitar cotización</h1>
      <p class="text-gray-600">
        El formulario de cotización estará disponible próximamente. Mientras tanto, escríbenos a
        <a class="text-accent underline" href="mailto:contacto@riff.cl">contacto@riff.cl</a>
        o llámanos al
        <a class="text-accent underline" href="tel:+56229079067">+56 2 29079067</a>.
      </p>
    </div>
  </main>
</Layout>
