---
import '@/styles/globals.css';
import TopHeader from '@/components/TopHeader.astro';
import Header from '@/components/Header.astro';
import SearchForm from '@/components/SearchForm.astro';
import Footer from '@/components/Footer.astro';
import SiteCredits from '@/components/SiteCredits.astro';
import { getContactInfo } from '@/lib/config/contact';
import { NAVIGATION_ITEMS, getCtaConfig } from '@/lib/config/navigation';
import { getSearchFormConfig } from '@/lib/config/search-form';
import { getSearchFormCategories } from '@/lib/api/categories';
import { SITE_FOOTER_CONTENT } from '@/lib/config/footer';
import { SITE_CREDITS_CONTENT } from '@/lib/config/site-credits';
import { Picture } from 'astro:assets';
import heroImage from '@/assets/img/banner_home.webp';
import type { HeaderProps } from '@/lib/types/header';
import type { SearchFormProps } from '@/lib/types/search-form';

interface Props {
  title: string;
  description?: string;
  /** Full-viewport hero shell used by the home page: full-bleed background
   * image + secondary overlay. Header/search-form render transparent so the
   * image shows through behind them. */
  hero?: boolean;
}

const { title, description = 'Catálogo digital de productos industriales Riff', hero = false } = Astro.props;
// AstroContainer tests have no `site` configured; in real builds the astro
// config always provides it. The fallback only guards the test environment.
const site = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = new URL(Astro.url.pathname || '/', site);
const socialImage = new URL('/og-image.png', site).href;
const contact = getContactInfo();

const headerProps: HeaderProps = {
  items: NAVIGATION_ITEMS,
  activePath: Astro.url.pathname,
  cta: getCtaConfig(),
  logoAlt: 'Riff',
};

// SearchForm initial state is read from the current URL's query params so the
// form preserves user input when navigating back from /productos (e.g. via the
// browser back button or a link). The component itself is dumb: it only
// consumes these props and renders.
const searchFormProps: SearchFormProps = {
  categories: await getSearchFormCategories(),
  config: getSearchFormConfig(),
  initialQuery: Astro.url.searchParams.get('q') ?? '',
  initialCategoriaId: Astro.url.searchParams.get('categoriaId') ?? '',
};
---

<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo_riff.png" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content="Riff Catálogo Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class:list={['min-h-screen flex flex-col', hero && 'overflow-x-hidden']}>
    {
      hero && (
        <>
          <Picture
            src={heroImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 800, 1200, 1920]}
            sizes="100vw"
            loading="eager"
            alt="Instalación industrial Riff de medición y tratamiento de fluidos"
            pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-secondary/80" aria-hidden="true"></div>
        </>
      )
    }
    <div class:list={['w-full', hero && 'relative z-10 flex flex-col min-h-screen']}>
      <TopHeader contact={contact} transparent={hero} />
      {/* Sticky group: Header + SearchForm stay fixed at the top on scroll.
          TopHeader scrolls away (not part of the sticky group). z-30 keeps the
          group above page content while staying below the mobile menu
          overlay (z-40) and toggle (z-50) defined inside Header. */}
      <div class="sticky top-0 z-30 header-scroll-shell">
        <Header {...headerProps} transparent={hero} />
        <SearchForm {...searchFormProps} transparent={hero} />
      </div>
      <slot />
      <Footer {...SITE_FOOTER_CONTENT} />
      <SiteCredits {...SITE_CREDITS_CONTENT} />
    </div>

    <!-- Compact scroll state: toggles `data-scrolled` on <body> on scroll.
         Imported (not inline) so `initHeaderScrollState` stays tree-shakeable
         and testable in lib/. -->
    <script>
      import { initHeaderScrollState } from '@/lib/scroll/createHeaderScrollState';
      initHeaderScrollState();
    </script>
  </body>
</html>