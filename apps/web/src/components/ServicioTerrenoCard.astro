---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ServicioTerrenoCardProps } from '@/lib/types/services-page';

interface Props extends ServicioTerrenoCardProps {}

const {
  slug,
  index,
  sector,
  title,
  description,
  image,
  imageAlt,
  imageCaptionLabel,
  imageCaption,
  body,
  ctaLabel,
  ctaHref,
  imagePosition,
} = Astro.props;

const formattedIndex = String(index).padStart(2, '0');
const isImageRight = imagePosition === 'right';
const imageOrder = isImageRight ? 'md:order-2' : 'md:order-1';
const contentOrder = isImageRight ? 'md:order-1' : 'md:order-2';
const imageBorder = isImageRight ? 'md:border-l' : 'md:border-r';
---

<!--
  Row for the "Servicios Especializados en Terreno" section (design.md
  D2/D3/D5/D7). Alternating image side, index + sector, <h3>, description and
  exactly one body variant (features | bullets | tags) driven by a discriminated
  union. Copy over the photo comes from props, not from the asset. Flat design
  and Astro <Image> for optimization (image-assets convention).
-->
<article
  id={slug}
  data-service-card
  class="grid grid-cols-1 md:grid-cols-12 border border-border bg-white scroll-mt-72 md:scroll-mt-40 lg:scroll-mt-44"
>
  <div
    data-service-image
    class:list={[
      'relative md:col-span-5 h-72 md:h-auto overflow-hidden border-b md:border-b-0 border-border',
      imageBorder,
      imageOrder,
    ]}
  >
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="(max-width: 768px) 100vw, 40vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      data-image-caption
      class="absolute bottom-0 left-0 right-0 bg-secondary-dark/90 text-white p-3 text-xs font-body"
    >
      <span class="text-primary font-bold block mb-0.5 font-heading">
        {imageCaptionLabel}
      </span>
      {imageCaption}
    </div>
  </div>

  <div
    data-service-content
    class:list={[
      'md:col-span-7 p-6 sm:p-8 flex flex-col justify-between border-t md:border-t-0 border-border',
      contentOrder,
    ]}
  >
    <div>
      <div class="flex items-center gap-3 mb-3">
        <span
          data-service-index
          class="text-accent font-heading font-bold text-sm tracking-wider uppercase"
        >
          {formattedIndex} // {sector}
        </span>
        <div class="h-px flex-grow bg-border"></div>
      </div>
      <h3 class="text-2xl font-bold font-heading text-secondary mb-3">
        {title}
      </h3>
      <p
        data-service-description
        class="text-sm sm:text-base text-text-2 leading-relaxed mb-4 font-body"
      >
        {description}
      </p>

      {
        body.kind === 'features' && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 text-xs">
            {body.features.map((feature) => (
              <div data-feature class="p-3 bg-bg border border-border">
                <strong class="text-secondary block mb-1 font-bold flex items-center gap-1.5 font-heading">
                  <Icon
                    name="lucide:square-check"
                    class="h-4 w-4 text-primary-dark"
                    aria-hidden="true"
                  />
                  {feature.title}
                </strong>
                <p class="text-text-2">{feature.description}</p>
              </div>
            ))}
          </div>
        )
      }

      {
        body.kind === 'bullets' && (
          <ul class="space-y-2 mb-6 text-xs text-text-2 font-medium">
            {body.bullets.map((bullet) => (
              <li data-bullet class="flex items-start gap-2">
                <Icon
                  name="lucide:circle-check"
                  data-icon="circle-check"
                  class="h-4 w-4 text-primary-dark shrink-0 mt-0.5"
                  aria-hidden="true"
                />
                <span>
                  <strong class="text-secondary">{bullet.strong}</strong>{' '}
                  {bullet.text}
                </span>
              </li>
            ))}
          </ul>
        )
      }

      {
        body.kind === 'tags' && (
          <div class="flex flex-wrap gap-2 mb-6">
            {body.tags.map((tag) => (
              <span
                data-tag
                class="border border-border bg-bg px-3 py-1.5 font-heading text-xs font-semibold text-text-2"
              >
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <div class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-4">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-5 py-2.5 text-xs font-bold font-heading uppercase tracking-wider transition-colors"
      >
        <span>{ctaLabel}</span>
        <Icon
          name="lucide:arrow-right"
          data-icon="arrow-right"
          class="h-4 w-4"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</article>
