---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ServicioTerreno } from '@/lib/types/services-page';

interface Props extends ServicioTerreno {}

const {
  slug,
  index,
  sector,
  title,
  description,
  image,
  imageAlt,
  imageCaptionLabel,
  imageCaption,
  body,
  ctaLabel,
  ctaHref,
} = Astro.props;

const formattedIndex = String(index).padStart(2, '0');
---

<!--
  Card for the "Servicios Especializados en Terreno" section (design.md
  D2/D3/D5/D7 and D4 post-apply). From md it is a single vertical column:
  index + sector, title, full-width 16:9 image, description and exactly one body
  variant (features | bullets | tags) driven by a discriminated union. The CTA
  closes the flow and reserves the FAB column on the right. Copy over the photo
  comes from props, not from the asset. Flat design and Astro <Image> for
  optimization (image-assets convention).
-->
<article
  id={slug}
  data-service-card
  class="flex flex-col border border-border bg-white scroll-mt-72 md:scroll-mt-40 lg:scroll-mt-44"
>
  <div
    data-service-header
    class="order-2 md:order-1 p-6 sm:p-8 pb-0 md:pb-6"
  >
    <div class="flex items-center gap-3 mb-3">
      <span
        data-service-index
        class="text-accent font-heading font-bold text-sm tracking-wider uppercase"
      >
        {formattedIndex} // {sector}
      </span>
      <div class="h-px flex-grow bg-border"></div>
    </div>
    <h3 class="text-2xl font-bold font-heading text-secondary mb-3">
      {title}
    </h3>
  </div>

  <div
    data-service-image
    class="order-1 md:order-2 relative w-full h-72 md:h-auto md:aspect-video overflow-hidden border-b md:border-y border-border"
  >
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      data-image-caption
      class="absolute bottom-0 left-0 right-0 bg-secondary-dark/90 text-white p-3 text-xs font-body"
    >
      <span class="text-primary font-bold block mb-0.5 font-heading">
        {imageCaptionLabel}
      </span>
      {imageCaption}
    </div>
  </div>

  <div
    data-service-content
    class="order-3 md:order-3 p-6 sm:p-8 pt-0 md:pt-6 flex flex-col"
  >
    <p
      data-service-description
      class="text-sm sm:text-base text-text-2 leading-relaxed mb-4 font-body"
    >
      {description}
    </p>

    {
      body.kind === 'features' && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 text-xs">
          {body.features.map((feature) => (
            <div data-feature class="p-3 bg-bg border border-border">
              <strong class="text-secondary block mb-1 font-bold flex items-center gap-1.5 font-heading">
                <Icon
                  name="lucide:square-check"
                  class="h-4 w-4 text-primary-dark"
                  aria-hidden="true"
                />
                {feature.title}
              </strong>
              <p class="text-text-2">{feature.description}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      body.kind === 'bullets' && (
        <ul class="space-y-2 mb-6 text-xs text-text-2 font-medium">
          {body.bullets.map((bullet) => (
            <li data-bullet class="flex items-start gap-2">
              <Icon
                name="lucide:circle-check"
                data-icon="circle-check"
                class="h-4 w-4 text-primary-dark shrink-0 mt-0.5"
                aria-hidden="true"
              />
              <span>
                <strong class="text-secondary">{bullet.strong}</strong>{' '}
                {bullet.text}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      body.kind === 'tags' && (
        <div class="flex flex-wrap gap-2 mb-6">
          {body.tags.map((tag) => (
            <span
              data-tag
              class="border border-border bg-bg px-3 py-1.5 font-heading text-xs font-semibold text-text-2"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div
      data-service-cta
      class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-4 md:pr-24"
    >
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-5 py-2.5 text-xs font-bold font-heading uppercase tracking-wider transition-colors"
      >
        <span>{ctaLabel}</span>
        <Icon
          name="lucide:arrow-right"
          data-icon="arrow-right"
          class="h-4 w-4"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</article>
