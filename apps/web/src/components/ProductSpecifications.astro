---
import { Icon } from 'astro-icon/components';
import type { AtributoApi } from '@/lib/types/products-page';

interface Props {
  atributos: readonly AtributoApi[];
  class?: string;
}

const { atributos, class: className = '' } = Astro.props;
---

{
  atributos.length > 0 && (
    <div class={`border border-border bg-white p-6 ${className}`} data-specifications>
      <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-primary">
        ESPECIFICACIONES CLAVE
      </h3>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {atributos.map((atributo) => (
          <li class="flex items-start gap-2 text-base text-text">
            <Icon name="lucide:check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
            <span>
              <span class="font-semibold">{atributo.nombre}:</span> {atributo.valor}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}
