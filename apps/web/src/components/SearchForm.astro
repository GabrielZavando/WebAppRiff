---
import type { SearchFormProps } from '@/lib/types/search-form';
import { Icon } from 'astro-icon/components';

interface Props extends SearchFormProps {
  /** Transparent wrapper on the home hero so the full-bleed image shows
   * through (default solid secondary wrapper). Controls keep their white fields. */
  transparent?: boolean;
}

const {
  categories,
  config,
  initialQuery = '',
  initialCategoriaId = '',
  transparent = false,
  showCategorySelect = true,
} = Astro.props;

// Stable ids for label↔control association. They are deterministic within the
// page (only one SearchForm is rendered per Layout) so the `for`/`id` bindings
// remain valid even when the component is reused.
const selectId = 'search-form-categoria';
const inputId = 'search-form-query';

// Determine which <option> carries the `selected` attribute. We cannot rely on
// browser defaults because Astro renders server-side and the initial state
// must reflect `initialCategoriaId` exactly so the URL state round-trips.
function isSelected(categoryId: string): boolean {
  if (initialCategoriaId === '') {
    // No initial selection → default option (empty id) is selected.
    return categoryId === '';
  }
  return categoryId === initialCategoriaId;
}
---

<!--
  Global search form, dumb presentational component. Receives all data
  through props; the layout (Layout.astro) owns the configuration via
  getSearchFormCategories() (backend-sourced at build time) and
  getSearchFormConfig(). Wrapped in a role="search" landmark so it doesn't
  introduce a new <header> landmark (single-header rule inherited from the
  site-header change).

  Wrapper background — two states only (SC-002/SC-003):
  - transparent=true (hero pages: `/`, `/servicios`): `bg-transparent` so the
    full-bleed hero image shows through.
  - default (every non-hero page): solid `bg-secondary` (var(--color-secondary)),
    the uniform color rule referenced from Inicio's compact state. No white
    wrapper, no bottom border, no gradient.
-->
<div
  role="search"
  aria-label="Buscar productos"
  class:list={[
    'site-search',
    transparent ? 'bg-transparent' : 'bg-secondary',
  ]}
>
  <!-- Inner container: 760px max-width centered. `px-4` adds horizontal
       breathing room on mobile so the form doesn't touch the screen edges;
       removed at `md` (md:px-0) so the 760px box uses its full width on desktop.
       On short viewports (height <= 400px, e.g. 568x320 landscape) the vertical
       padding is reduced so the sticky group fits the viewport-height budget. -->
  <div class="max-w-[760px] mx-auto py-4 px-4 md:px-0 [@media(max-height:400px)]:py-2">
    <form
      method="get"
      action={config.action}
      data-search-form
      class="grid grid-cols-[minmax(0,1fr)_auto] gap-y-3 sm:flex sm:flex-row sm:gap-px [@media(max-height:400px)]:flex [@media(max-height:400px)]:flex-row"
    >
      {
        showCategorySelect && (
          <div class="col-span-2 w-full sm:w-64 sm:shrink-0 min-w-0 max-sm:[@media(max-height:400px)]:w-44 max-sm:[@media(max-height:400px)]:shrink-0">
            <label for={selectId} class="sr-only">Filtrar por categoría</label>
            <select
              id={selectId}
              name={config.selectName}
              class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary [@media(max-height:400px)]:h-9"
            >
              {categories.map((category) => (
                <option value={category.id} selected={isSelected(category.id)}>
                  {category.label}
                </option>
              ))}
            </select>
          </div>
        )
      }

      <div class="w-full sm:flex-1 min-w-0">
        <label for={inputId} class="sr-only">Buscar productos</label>
        <input
          id={inputId}
          type="search"
          name={config.inputName}
          placeholder={config.inputPlaceholder}
          value={initialQuery}
          class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary [@media(max-height:400px)]:h-9"
        />
      </div>

      <button
        type="submit"
        aria-label="BUSCAR"
        class="flex shrink-0 items-center justify-center gap-2 h-11 px-4 sm:px-8 font-heading font-semibold uppercase text-xs tracking-wide whitespace-nowrap bg-primary hover:bg-primary-dark text-white transition-colors [@media(max-height:400px)]:h-9 [@media(max-height:400px)]:px-4"
      >
        <!-- Search icon (decorative: aria-hidden, accessible name is provided by
             aria-label="BUSCAR" on mobile and by the visible label from sm upward).
             Mobile shows the icon only; from sm the label is restored with the
             original 8px gap and wider horizontal padding. -->
        <Icon name="lucide:search" class="h-4 w-4" aria-hidden="true" />
        <span class="hidden sm:inline">{config.submitLabel}</span>
      </button>
    </form>
  </div>
</div>

<script is:inline>
  // Progressive enhancement: when JS is enabled, intercept the form submit
  // and build a canonical URL omitting empty fields (e.g. `?q=&categoriaId=`
  // becomes just `/productos`). Mirrors the logic of buildSearchHref() on the
  // server side. If JS is disabled, the native `<form method="get">` still
  // works and the backend treats empty params as no-filter.
  document.querySelectorAll('form[data-search-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const query = String(data.get('q') ?? '').trim();
      const categoriaId = String(data.get('categoriaId') ?? '');
      const action = form.getAttribute('action') || '/productos';
      const params = new URLSearchParams();
      if (query !== '') {
        params.set('q', query);
      }
      if (categoriaId !== '') {
        params.set('categoriaId', categoriaId);
      }
      const queryString = params.toString();
      window.location.href = queryString === '' ? action : `${action}?${queryString}`;
    });
  });
</script>
