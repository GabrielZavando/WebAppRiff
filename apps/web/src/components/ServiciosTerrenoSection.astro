---
import type { ServiciosTerrenoSectionProps } from '@/lib/types/services-page';
import ServiciosSectionHeading from '@/components/ServiciosSectionHeading.astro';
import ServicioTerrenoCard from '@/components/ServicioTerrenoCard.astro';

interface Props extends ServiciosTerrenoSectionProps {}

const { eyebrow, headline, intro, services } = Astro.props;
---

<!--
  Section 2 of /servicios (design.md D2/D3/D7 and D4 post-apply): four vertical
  service cards with images from @/assets/img/ and a single body variant per
  card. Background: bg-primary-100 with top/bottom borders. All content comes
  from props; the card owns the md+ column order.
-->
<section
  data-section="field-services"
  class="w-full bg-primary-100 border-y border-border py-16"
>
  <div class="container">
    <ServiciosSectionHeading
      eyebrow={eyebrow}
      headline={headline}
      intro={intro}
      markerTone="accent"
    />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {
        services.map((service) => (
          <ServicioTerrenoCard {...service} />
        ))
      }
    </div>
  </div>
</section>
