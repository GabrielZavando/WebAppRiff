---
import type { NosotrosTeamGridProps } from '@/lib/types/nosotros-page';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

interface Props extends NosotrosTeamGridProps {}

const { eyebrow, title, subtitle, badgeText, badgeIcon, members } =
  Astro.props;
---

<!--
  Dumb presentational component for the /nosotros leadership team
  (section 5 of the approved reference, SC-206). All copy, portraits and
  icons come via props spread from `NOSOTROS_PAGE_CONTENT.team` by the page.
  The name avoids colliding with the home's `NosotrosTeamSection.astro`
  (a different 3-member piece, design.md D2).

  Layout (design.md § Decisions 4/6/10/11/12):
    - Header row: copy left, accreditation badge right (stacks on mobile).
    - Cards grid collapses 1 → 2 → 4 columns (SC-211); each card renders
      only the 3:4 portrait (local asset, lazy), name `<h3>`, exact role
      and verbatim roster description. The area badge and the icon footer
      were removed in the `team-members` change.
    - Photo zoom on hover is disabled under `prefers-reduced-motion`
      (precedent: `NosotrosTeamSection.astro` scoped styles).
    - Flat design: no `rounded*`, no hex literals; card shadow `shadow-1`
      with `shadow-2` on hover (design.md D11).
-->
<section class="w-full bg-white py-16 md:py-20">
  <div class="container mx-auto">
    <div class="mb-16 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <div
          class="mb-1 inline-flex items-center gap-1 font-heading text-sm font-semibold uppercase tracking-wider text-primary"
        >
          <span class="h-0.5 w-8 bg-primary"></span>
          <span>{eyebrow}</span>
        </div>
        <h2 class="font-heading text-2xl uppercase tracking-tight text-text md:text-3xl"
          >{title}</h2
        >
        <p class="mt-1 font-body text-lg text-text-2">{subtitle}</p>
      </div>
      <div
        class="inline-flex items-center gap-1 bg-bg p-2 font-heading text-xs font-semibold text-text"
      >
        <Icon
          name={`lucide:${badgeIcon}`}
          class="h-5 w-5 text-primary"
          aria-hidden="true"
        />
        <span>{badgeText}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        members.map((member) => (
          <article class="group flex flex-col overflow-hidden bg-bg shadow-1 transition-shadow hover:shadow-2">
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-secondary">
              <Image
                src={member.image}
                alt={member.imageAlt}
                class="team-grid-photo absolute inset-0 h-full w-full object-cover contrast-125"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-heading text-xl text-text">{member.name}</h3>
              <span class="mb-2 block font-heading text-xs font-semibold uppercase tracking-wider text-accent">
                {member.role}
              </span>
              <p class="font-body text-xs leading-relaxed text-text-2">
                {member.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-grid-photo {
    transition: transform 500ms ease-out;
    will-change: transform;
  }

  .group:hover .team-grid-photo {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-grid-photo {
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>
