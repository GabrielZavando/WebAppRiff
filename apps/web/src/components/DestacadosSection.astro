---
import type { DestacadosSectionProps } from '@/lib/types/destacados-section';

interface Props extends DestacadosSectionProps {}

const { headline, ctaText, ctaHref, products } = Astro.props;
---

<!--
  Dumb presentational component. All content (headline, header CTA and the
  featured product cards) comes via props: the headline/CTA copy from
  `DESTACADOS_SECTION_CONTENT` and the cards from the backend featured
  catalog (`getFeaturedProducts()` capped at 8 by the page, mapped with
  `toFeaturedProduct` — panel-managed `destacado` flag).

  Layout (see openspec/changes/home-featured-products-grid):
    - The <section> is a flat block: `py-16 md:py-24` vertical air and
      `bg-secondary-dark` background (dark navy), hard color transition from
      the teal `bg-primary-deep` of `ServicesSection` above.
    - Inner `<div class="container mx-auto px-4 sm:px-6 lg:px-8">` constrains
      content to the same max-width as the sibling sections (token
      `.container` in globals.css).
    - Header row `flex flex-col sm:flex-row justify-between items-start
      sm:items-center`: left holds the <h3> headline, right holds the accent
      CTA; on mobile the CTA stacks below the headline.
    - Card grid `grid-cols-1 sm:grid-cols-2 lg:grid-cols-4` (gap-6 md:gap-8):
      mobile 1 col, tablet >= 640px 2 cols, desktop >= 1024px 4 cols. With
      5..8 cards CSS Grid auto-placement flows them into the second row.
    - Card layout: white `<article>` (`bg-white shadow-2 hover:shadow-4
      transition-shadow`) with an image mat (`p-4`, `aspect-square
      object-contain`) so product shots are not cropped, and a content area
      with the <h4> + "Ver detalles" CTA.

  Semantics & accessibility:
    - The section headline is a <h3>, NOT <h1>/<h2>: the home has exactly one
      <h1> (HeroBanner) and one <h2> (PanelHome); DestacadosSection is a
      sibling portfolio sub-block like SolutionSection/ServicesSection.
    - Each card title is a <h4> subordinate to the section <h3>.
    - Images: remote product URLs managed by the panel (Firebase Storage),
      rendered as plain <img loading="lazy"> with a descriptive alt (gallery
      alt falling back to the title) — NO astro:assets (the URL is not an
      importable asset) and NO <svg> placeholder when the product has no
      image (the mat stays blank; icons are deliberately not used here).
    - NO prices rendered anywhere (the section shows no prices).
-->

<section class="py-16 md:py-24 bg-secondary-dark">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header row: headline left, accent CTA right (stacks on mobile) -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
      <h3 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white">
        {headline}
      </h3>
      <a
        href={ctaHref}
        class="bg-accent hover:bg-accent-dark text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 transition-colors"
      >
        {ctaText}
      </a>
    </div>

    <!-- Responsive card grid: 1 / 2 / 4 columns, second row auto-flows -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {
        products.map((product) => (
          <article class="bg-white shadow-2 hover:shadow-4 transition-shadow">
            <div class="p-4">
              {product.imageUrl !== '' && (
                <img
                  src={product.imageUrl}
                  alt={product.imagenAlt}
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-square object-contain"
                />
              )}
            </div>
            <div class="p-5">
              <h4 class="text-base font-heading font-semibold text-secondary line-clamp-3 min-h-[4.5rem]">
                {product.titulo}
              </h4>
              <a
                href={`/productos/${product.slug}`}
                class="mt-4 block text-center border-2 border-primary text-primary hover:bg-primary hover:text-white font-heading font-semibold uppercase text-xs tracking-wide px-4 py-3 transition-colors"
              >
                Ver detalles
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>