---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Distribuidor } from '@/lib/types/representaciones-page';

interface Props extends Distribuidor {}

const { name, logo, badge, icon, title, description, bullets, guarantee } =
  Astro.props;
---

<!--
  Authorized distributor card (PIUSI, SENSUS) for the
  "Distribuidores Autorizados" section (design.md § D1/D2/D4/D6). The real
  brand logo (astro:assets <Image>, WebP in build) lives inside a
  `data-brand-logo` container; the thematic icon is a Lucide name from config
  rendered via astro-icon. The check-list uses a decorative `lucide:check` per
  bullet. Flat: bg-white, border-border, no rounded-*, no shadow-*.
-->
<article
  data-distributor-card
  class="bg-white border border-border flex flex-col justify-between p-8 h-full"
>
  <div>
    <div class="flex items-center justify-between pb-6 gap-3">
      <div data-brand-logo>
        <Image
          src={logo}
          alt={name}
          widths={[128, 256]}
          sizes="(max-width: 1024px) 50vw, 256px"
          loading="lazy"
          class="h-auto w-full max-w-[180px] object-contain"
        />
      </div>
      <span
        class="bg-bg text-text-2 font-heading text-xs font-semibold px-3 py-1 uppercase whitespace-nowrap"
      >
        {badge}
      </span>
    </div>
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2 text-primary">
        <Icon name={icon} class="h-6 w-6 shrink-0" aria-hidden="true" />
        <h3 class="font-heading text-xl font-bold text-text">{title}</h3>
      </div>
      <p class="font-body text-text-2">{description}</p>
      <ul class="flex flex-col gap-2 pt-2">
        {
          bullets.map((bullet) => (
            <li class="flex items-start gap-2 text-text-2 font-body">
              <Icon
                name="lucide:check"
                class="h-4 w-4 text-primary shrink-0 mt-0.5"
                aria-hidden="true"
              />
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="pt-8 mt-6">
    <span class="font-body text-xs text-text-2">{guarantee}</span>
  </div>
</article>
