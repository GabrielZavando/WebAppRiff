-y-1"><dd class="font-body text-sm text-muted">9:00 a 13:00 hrs.</dd><dd class="font-body text-sm text-muted">14:00 a 18:00 hrs.</dd></div></div><div class="flex items-baseline justify-between gap-4"><dt class="font-body text-sm font-semibold text-white">Viernes</dt><div class="space-y-1"><dd class="font-body text-sm text-muted">9:00 a 13:00 hrs.</dd><dd class="font-body text-sm text-muted">14:00 a 17:00 hrs.</dd></div></div></dl><p class="mt-6 flex items-center gap-2 font-body text-sm font-semibold text-primary"><svg width="1em" height="1em" class="h-4 w-4" aria-hidden="true" data-icon="lucide:clock"><symbol id="ai:lucide:clock" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></g></symbol><use href="#ai:lucide:clock"></use></svg>Soporte 24/7 disponible</p></div></div></div><div class="border-t border-white/10" aria-hidden="true"></div><div class="container flex flex-col items-center justify-between gap-4 py-6 sm:flex-row"><span class="font-body text-xs uppercase tracking-wide text-muted">© 2024 RIFF SPA. TODOS LOS DERECHOS RESERVADOS.</span><div class="flex items-center gap-4"><span class="font-body text-xs uppercase tracking-wide text-muted">SANTIAGO, CHILE</span><button type="button" data-scroll-top aria-label="Volver arriba" class="flex h-10 w-10 items-center justify-center bg-primary text-white transition-colors hover:bg-primary-dark"><svg width="1em" height="1em" class="h-4 w-4" aria-hidden="true" data-icon="lucide:arrow-up"><symbol id="ai:lucide:arrow-up" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12l7-7l7 7m-7 7V5"/></symbol><use href="#ai:lucide:arrow-up"></use></svg></button></div></div></footer><script>
  // Smooth-scrolls to the top when the footer's scroll-to-top button is
  // clicked (design.md § Decision 6). \`behavior: 'smooth'\` is a progressive
  // enhancement: browsers honoring \`prefers-reduced-motion\` ignore it and
  // jump instantly, so no matchMedia override is needed.
  document.querySelectorAll('[data-scroll-top]').forEach((button) => {
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>"
