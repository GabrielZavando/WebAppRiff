exports[`HeroBanner — snapshot > matches the snapshot for base props 1`] = `"<section class="relative"><div class="relative container mx-auto py-16 md:py-24 lg:py-32"><h1 class="text-4xl md:text-6xl font-heading font-bold text-white">Innovación que <span class="text-primary">Fluye</span></h1><h2 class="mt-4 text-xl md:text-2xl font-heading font-semibold text-white/90 max-w-3xl">Experiencia, tecnología y control en medición de fluidos y tratamientos de agua.</h2><p class="mt-6 text-base text-white/80 max-w-2xl">Desarrollamos soluciones para la medición, control y tratamiento de agua, integrando equipos, soporte técnico y ejecución en terreno.</p><div class="mt-8 flex flex-col sm:flex-row gap-3"><a href="/servicios" class="px-8 py-3 font-heading font-semibold uppercase tracking-wide text-xs transition-colors bg-primary hover:bg-primary-dark text-white">VER SERVICIOS</a><a href="/contacto" class="px-8 py-3 font-heading font-semibold uppercase tracking-wide text-xs transition-colors border-2 border-white text-white hover:bg-white hover:text-secondary">ESCRÍBENOS</a></div></div></section>"`;
