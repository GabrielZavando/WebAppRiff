// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SearchForm — snapshot > matches the snapshot for full SearchForm 1`] = `
"<!--
  Global search form, dumb presentational component. Receives all data
  through props; the layout (Layout.astro) owns the configuration via
  CATEGORY_OPTIONS and getSearchFormConfig(). Wrapped in a role="search"
  landmark so it doesn't introduce a new <header> landmark (single-header
  rule inherited from the site-header change).
--><div role="search" aria-label="Buscar productos" class="bg-white border-b border-border"><!-- Inner container: 760px max-width centered. \`px-4\` adds horizontal
       breathing room on mobile so the form doesn't touch the screen edges;
       removed at \`md\` (md:px-0) so the 760px box uses its full width on desktop. --><div class="max-w-[760px] mx-auto py-4 px-4 md:px-0"><form method="get" action="/productos" data-search-form class="flex flex-col md:flex-row gap-3 md:gap-px"><div class="w-full md:w-56"><label for="search-form-categoria" class="sr-only">Filtrar por categoría</label><select id="search-form-categoria" name="categoriaId" class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary"><option value selected>Todas las categorías</option><option value="herramientas">Herramientas</option><option value="seguridad">Seguridad</option><option value="electricidad">Electricidad</option></select></div><div class="w-full md:flex-1"><label for="search-form-query" class="sr-only">Buscar productos</label><input id="search-form-query" type="search" name="q" placeholder="¿Qué productos estás buscando?" value class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><button type="submit" class="flex items-center justify-center gap-2 w-full md:w-auto h-11 px-8 font-heading font-semibold uppercase text-xs tracking-wide whitespace-nowrap bg-primary hover:bg-primary-dark text-white transition-colors"><!-- Search icon (decorative: aria-hidden, accessible name is "BUSCAR" text).
             Flex layout centers the 16px icon with the 12px text; gap-2 (8px) spaces them.
             Wider horizontal padding gives the button a more balanced desktop
             presentation alongside the select and input. --><svg width="1em" height="1em" class="h-4 w-4" aria-hidden="true" data-icon="lucide:search"><symbol id="ai:lucide:search" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></g></symbol><use href="#ai:lucide:search"></use></svg>BUSCAR</button></form></div></div><script>
  // Progressive enhancement: when JS is enabled, intercept the form submit
  // and build a canonical URL omitting empty fields (e.g. \`?q=&categoriaId=\`
  // becomes just \`/productos\`). Mirrors the logic of buildSearchHref() on the
  // server side. If JS is disabled, the native \`<form method="get">\` still
  // works and the backend treats empty params as no-filter.
  document.querySelectorAll('form[data-search-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const query = String(data.get('q') ?? '').trim();
      const categoriaId = String(data.get('categoriaId') ?? '');
      const action = form.getAttribute('action') || '/productos';
      const params = new URLSearchParams();
      if (query !== '') {
        params.set('q', query);
      }
      if (categoriaId !== '') {
        params.set('categoriaId', categoriaId);
      }
      const queryString = params.toString();
      window.location.href = queryString === '' ? action : \`\${action}?\${queryString}\`;
    });
  });
</script>"
`;
