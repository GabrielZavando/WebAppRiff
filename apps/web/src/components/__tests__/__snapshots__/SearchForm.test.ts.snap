// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SearchForm — snapshot > matches the snapshot for full SearchForm 1`] = `
"<!--
  Global search form, dumb presentational component. Receives all data
  through props; the layout (Layout.astro) owns the configuration via
  getSearchFormCategories() (backend-sourced at build time) and
  getSearchFormConfig(). Wrapped in a role="search" landmark so it doesn't
  introduce a new <header> landmark (single-header rule inherited from the
  site-header change).

  Wrapper background — two states only (SC-002/SC-003):
  - transparent=true (hero pages: \`/\`, \`/servicios\`): \`bg-transparent\` so the
    full-bleed hero image shows through.
  - default (every non-hero page): solid \`bg-secondary\` (var(--color-secondary)),
    the uniform color rule referenced from Inicio's compact state. No white
    wrapper, no bottom border, no gradient.
--><div role="search" aria-label="Buscar productos" class="site-search bg-secondary"><!-- Inner container: centered. \`px-4\` adds horizontal breathing room on
       mobile so the form doesn't touch the screen edges; removed at \`md\`
       (md:px-0). From \`md\` to \`< xl\` the container occupies 90% of the
       viewport width with no 760px cap (md:w-[90%] md:max-w-none); from \`xl\`
       the approved 760px maximum is restored (xl:max-w-[760px]).
       On short viewports (height <= 400px, e.g. 568x320 landscape) the vertical
       padding is reduced so the sticky group fits the viewport-height budget.
       Row layout (mobile-first): below \`sm\` the form is a two-column grid
       (select on its own row, input + button below); from \`sm\` it is a single
       flex row where the select and the input share the free width evenly
       (\`sm:flex-1\` on both) and the icon-only button stays capped at 60px
       (\`sm:max-w-[60px]\`). --><div class="w-full max-w-[760px] mx-auto py-4 px-4 md:w-[90%] md:max-w-none md:px-0 xl:max-w-[760px] [@media(max-height:400px)]:py-2"><form method="get" action="/productos" data-search-form class="grid grid-cols-[minmax(0,1fr)_auto] gap-y-3 sm:flex sm:flex-row sm:gap-px [@media(max-height:400px)]:flex [@media(max-height:400px)]:flex-row"><div class="col-span-2 w-full sm:flex-1 min-w-0 max-sm:[@media(max-height:400px)]:w-44 max-sm:[@media(max-height:400px)]:shrink-0"><label for="search-form-categoria" class="sr-only">Filtrar por categoría</label><select id="search-form-categoria" name="categoriaId" class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary [@media(max-height:400px)]:h-9"><option value selected>Todas las categorías</option><option value="herramientas">Herramientas</option><option value="seguridad">Seguridad</option><option value="electricidad">Electricidad</option></select></div><div class="w-full sm:flex-1 min-w-0"><label for="search-form-query" class="sr-only">Buscar productos</label><input id="search-form-query" type="search" name="q" placeholder="¿Qué estás buscando?" value class="w-full h-11 border border-border bg-white px-3 text-sm text-text-2 focus:outline-none focus:border-primary [@media(max-height:400px)]:h-9"></div><button type="submit" aria-label="BUSCAR" class="flex shrink-0 items-center justify-center gap-2 h-11 px-4 sm:max-w-[60px] lg:max-w-[78px] lg:min-w-[80px] font-heading font-semibold uppercase text-xs tracking-wide whitespace-nowrap bg-primary hover:bg-primary-dark text-white transition-colors [@media(max-height:400px)]:h-9 [@media(max-height:400px)]:px-4"><!-- Search icon (decorative: aria-hidden, accessible name is provided by
             aria-label="BUSCAR" at every breakpoint). The button is icon-only:
             the label text stays in the DOM (preserving the icon → label order)
             but is hidden at every breakpoint. From sm the button is capped at
             60px (sm:max-w-[60px]) so the freed width goes to the select and
             the input, which split the remaining space evenly (sm:flex-1). --><svg width="1em" height="1em" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" data-icon="lucide:search"><symbol id="ai:lucide:search"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></g></symbol><use href="#ai:lucide:search"></use></svg><span class="hidden">BUSCAR</span></button></form></div></div><script>
  // Progressive enhancement: when JS is enabled, intercept the form submit
  // and build a canonical URL omitting empty fields (e.g. \`?q=&categoriaId=\`
  // becomes just \`/productos\`). Mirrors the logic of buildSearchHref() on the
  // server side. If JS is disabled, the native \`<form method="get">\` still
  // works and the backend treats empty params as no-filter.
  document.querySelectorAll('form[data-search-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const query = String(data.get('q') ?? '').trim();
      const categoriaId = String(data.get('categoriaId') ?? '');
      const action = form.getAttribute('action') || '/productos';
      const params = new URLSearchParams();
      if (query !== '') {
        params.set('q', query);
      }
      if (categoriaId !== '') {
        params.set('categoriaId', categoriaId);
      }
      const queryString = params.toString();
      window.location.href = queryString === '' ? action : \`\${action}?\${queryString}\`;
    });
  });
</script>"
`;
