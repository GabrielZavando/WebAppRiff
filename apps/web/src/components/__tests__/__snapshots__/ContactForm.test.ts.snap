// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ContactForm — snapshot > matches the snapshot 1`] = `
"<!--
  Dumb presentational component for the contact page form. All content (areas,
  copy, placeholders, action) comes via props spread from
  \`CONTACT_PAGE_CONTENT.form\` by \`apps/web/src/pages/contacto.astro\`.

  Layout:
    - Outermost <form method="post" action={config.action}> (native HTML
      submit; the future backend endpoint \`POST /api/v1/contacts\` consumes it).
    - Text inputs grid \`grid-cols-1 md:grid-cols-2\` (mobile stacked, desktop
      two columns): Nombre | Empresa, Email | Teléfono.
    - Areas of interest: a single <fieldset> with <legend> "ÁREA DE INTERÉS"
      wrapping 5 checkboxes in a \`grid-cols-1 sm:grid-cols-2\` grid. Each
      checkbox has an associated <label> via \`for\`/\`id\`.
    - Message: full-width <textarea> with associated <label>.
    - Submit: <button type="submit"> with accent token + decorative arrow icon.

  Accessibility: every control has a visible <label> associated via \`for\`/\`id\`;
  checkboxes are grouped in a fieldset/legend; the button relies on its visible
  text (no extra aria-label). Native HTML5 validation (\`required\`, \`type\`) is
  used so the form is operable without JavaScript.

  Strict flat design: no \`rounded*\` and no \`shadow*\` in the static state.
--><div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-0"><!-- White box spanning the full page content width (same container/side
       margins as the site header). Flat design: 1px border, no shadow, no
       rounded corners. --><form method="post" action="/api/v1/contacts" class="bg-white border border-border"><div class="px-6 py-10 md:px-10 md:py-12"><!-- Header --><h2 class="text-2xl md:text-3xl font-heading font-bold text-secondary">Solicitud de Contacto Técnico</h2><p class="mt-2 font-body text-sm text-text-2">Complete el formulario y nuestro equipo de ingenieros se pondrá en contacto con usted a la brevedad.</p><!-- Text inputs: mobile stacked, desktop two columns --><div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5"><div><label for="contact-nombre" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">NOMBRE COMPLETO</label><input id="contact-nombre" name="nombre" type="text" required placeholder="Ej. Juan Pérez" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-empresa" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">EMPRESA</label><input id="contact-empresa" name="empresa" type="text" required placeholder="Razón Social" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-email" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">CORREO ELECTRÓNICO</label><input id="contact-email" name="email" type="email" required placeholder="correo@empresa.com" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-telefono" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">TELÉFONO</label><input id="contact-telefono" name="telefono" type="tel" required placeholder="+56 9 0000 0000" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div></div><!-- Areas of interest: fieldset + legend, two-column checkbox grid --><fieldset class="mt-8"><legend class="font-heading text-xs font-semibold uppercase tracking-wider text-secondary">ÁREA DE INTERÉS</legend><div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3"><div class="flex items-center gap-2"><input id="contact-area-medicion-fluidos" name="areasDeInteres" type="checkbox" value="medicion-fluidos" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-medicion-fluidos" class="font-body text-sm text-text-2">Medición de Fluidos</label></div><div class="flex items-center gap-2"><input id="contact-area-tratamiento-agua" name="areasDeInteres" type="checkbox" value="tratamiento-agua" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-tratamiento-agua" class="font-body text-sm text-text-2">Tratamiento de Agua</label></div><div class="flex items-center gap-2"><input id="contact-area-productos-quimicos" name="areasDeInteres" type="checkbox" value="productos-quimicos" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-productos-quimicos" class="font-body text-sm text-text-2">Productos Químicos</label></div><div class="flex items-center gap-2"><input id="contact-area-control-accesorios" name="areasDeInteres" type="checkbox" value="control-accesorios" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-control-accesorios" class="font-body text-sm text-text-2">Control y Accesorios</label></div><div class="flex items-center gap-2"><input id="contact-area-servicio-tecnico" name="areasDeInteres" type="checkbox" value="servicio-tecnico" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-servicio-tecnico" class="font-body text-sm text-text-2">Servicio Técnico</label></div></div></fieldset><!-- Message textarea --><div class="mt-8"><label for="contact-mensaje" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">MENSAJE O REQUERIMIENTO ESPECÍFICO</label><textarea id="contact-mensaje" name="mensaje" required placeholder="Describa los detalles técnicos de su solicitud..." rows="5" class="mt-2 w-full border border-border bg-bg px-3 py-2 text-sm text-text-2 focus:outline-none focus:border-primary"></textarea></div><!-- Submit: full width, text left, arrow icon right --><div class="mt-8"><button type="submit" class="flex w-full items-center justify-center gap-3 px-8 py-3 font-heading font-semibold uppercase text-xs tracking-wide bg-accent hover:bg-accent-dark text-white transition-colors"><span>ENVIAR MENSAJE</span><svg width="1em" height="1em" class="h-4 w-4" aria-hidden="true" data-icon="lucide:arrow-right"><symbol id="ai:lucide:arrow-right" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7-7l7 7l-7 7"/></symbol><use href="#ai:lucide:arrow-right"></use></svg></button></div></div></form></div>"
`;
