// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ContactForm — snapshot > matches the snapshot 1`] = `
"<!--
  Dumb presentational component for the contact page form. All content (areas,
  copy, placeholders, action) comes via props spread from
  \`CONTACT_PAGE_CONTENT.form\` by \`apps/web/src/pages/contacto.astro\`.

  Layout:
    - Outermost <form method="post" action={resolvedAction}> (native HTML
      submit; resolved to absolute API URL via \`resolveFormSubmitUrl\`).
    - Text inputs grid \`grid-cols-1 md:grid-cols-2\` (mobile stacked, desktop
      two columns): Nombre | Empresa, Email | Teléfono.
    - Areas of interest: a single <fieldset> with <legend> "ÁREA DE INTERÉS"
      wrapping 5 checkboxes in a \`grid-cols-1 sm:grid-cols-2\` grid. Each
      checkbox has an associated <label> via \`for\`/\`id\`.
    - Message: full-width <textarea> with associated <label>.
    - Submit: <button type="submit"> with accent token + decorative arrow icon.

  Accessibility: every control has a visible <label> associated via \`for\`/\`id\`;
  checkboxes are grouped in a fieldset/legend; the button relies on its visible
  text (no extra aria-label). Native HTML5 validation (\`required\`, \`type\`) is
  used so the form is operable without JavaScript.

  Strict flat design: no \`rounded*\` and no \`shadow*\` in the static state.
--><div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-0"><!-- White box spanning the full page content width (same container/side
       margins as the site header). Flat design: 1px border, no shadow, no
       rounded corners. --><form id="contact-form" method="post" action="http://localhost:3000/api/v1/contacts" class="bg-white border border-border" data-success-message="Mensaje enviado. Nuestro equipo de ingenieros lo contactará a la brevedad." data-error-message="No pudimos enviar el mensaje. Verifique los datos e intente nuevamente."><!-- Anti-spam honeypot: off-screen field a human never fills (not
         display:none, so bots that skip hidden fields still trip the trap).
         The backend rejects the submission silently when it carries a value. --><div class="sr-only" aria-hidden="true"><label for="contact-website">No completar este campo</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true"></div><div class="px-6 py-10 md:px-10 md:py-12"><!-- Header --><h2 class="text-2xl md:text-3xl font-heading font-bold text-secondary">Solicitud de Contacto Técnico</h2><p class="mt-2 font-body text-sm text-text-2">Complete el formulario y nuestro equipo de ingenieros se pondrá en contacto con usted a la brevedad.</p><p class="mt-2 font-body text-xs text-muted">Los campos marcados con<span aria-hidden="true">*</span> son obligatorios.</p><!-- Text inputs: mobile stacked, desktop two columns --><div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5"><div><label for="contact-nombre" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">NOMBRE COMPLETO<span aria-hidden="true" class="text-accent">*</span></label><input id="contact-nombre" name="nombre" type="text" required placeholder="Ej. Juan Pérez" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-empresa" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">EMPRESA<span aria-hidden="true" class="text-accent">*</span></label><input id="contact-empresa" name="empresa" type="text" required placeholder="Razón Social" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-email" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">CORREO ELECTRÓNICO<span aria-hidden="true" class="text-accent">*</span></label><input id="contact-email" name="email" type="email" required placeholder="correo@empresa.com" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div><div><label for="contact-telefono" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">TELÉFONO<span aria-hidden="true" class="text-accent">*</span></label><input id="contact-telefono" name="telefono" type="tel" required placeholder="+56 9 0000 0000" class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"></div></div><!-- Areas of interest: fieldset + legend, two-column checkbox grid --><fieldset class="mt-8"><legend class="font-heading text-xs font-semibold uppercase tracking-wider text-secondary">ÁREA DE INTERÉS</legend><div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3"><div class="flex items-center gap-2"><input id="contact-area-medicion-fluidos" name="areasDeInteres" type="checkbox" value="medicion-fluidos" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-medicion-fluidos" class="font-body text-sm text-text-2">Medición de Fluidos</label></div><div class="flex items-center gap-2"><input id="contact-area-tratamiento-agua" name="areasDeInteres" type="checkbox" value="tratamiento-agua" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-tratamiento-agua" class="font-body text-sm text-text-2">Tratamiento de Agua</label></div><div class="flex items-center gap-2"><input id="contact-area-productos-quimicos" name="areasDeInteres" type="checkbox" value="productos-quimicos" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-productos-quimicos" class="font-body text-sm text-text-2">Productos Químicos</label></div><div class="flex items-center gap-2"><input id="contact-area-control-accesorios" name="areasDeInteres" type="checkbox" value="control-accesorios" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-control-accesorios" class="font-body text-sm text-text-2">Control y Accesorios</label></div><div class="flex items-center gap-2"><input id="contact-area-servicio-tecnico" name="areasDeInteres" type="checkbox" value="servicio-tecnico" class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"><label for="contact-area-servicio-tecnico" class="font-body text-sm text-text-2">Servicio Técnico</label></div></div></fieldset><!-- Message textarea --><div class="mt-8"><label for="contact-mensaje" class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary">MENSAJE O REQUERIMIENTO ESPECÍFICO<span aria-hidden="true" class="text-accent">*</span></label><textarea id="contact-mensaje" name="mensaje" required placeholder="Describa los detalles técnicos de su solicitud..." rows="5" class="mt-2 w-full border border-border bg-bg px-3 py-2 text-sm text-text-2 focus:outline-none focus:border-primary"></textarea></div><!-- Submit: full width, text left, arrow icon right --><div class="mt-8"><button type="submit" class="flex w-full items-center justify-center gap-3 px-8 py-3 font-heading font-semibold uppercase text-xs tracking-wide bg-accent hover:bg-accent-dark text-white transition-colors"><span>ENVIAR MENSAJE</span><svg width="1em" height="1em" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" data-icon="lucide:arrow-right"><symbol id="ai:lucide:arrow-right"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7-7l7 7l-7 7"/></symbol><use href="#ai:lucide:arrow-right"></use></svg></button></div></div></form><!-- Toast notification (capability ui-toast): replaces the former inline
       status block. Pre-rendered hidden with an empty live region (never
       mounted on the fly); the form runtime (formSubmitClient) publishes the
       result as the \`riff:form-result\` custom event and the toast shows it. --><!--
  Reusable, page-agnostic toast notification for the lead-capture forms
  (design.md D4/D5/D8/D10):

  - The root carries \`data-form-toast\` (the contract marker resolved by
    \`initFormToast\` at event time), \`data-variant\` and \`data-state\`, and starts
    hidden: the aria-live region exists EMPTY and pre-rendered in the initial
    HTML (SSG) — never mounted on the fly — so screen readers register it
    before any content change. The message is only filled upon receiving the
    form result.
  - Fixed at the top-right corner (\`fixed top-6 right-6 z-40\`), above the page
    content (≤ z-10), the WhatsApp FAB (z-20) and the sticky header shell
    (z-30, whose overlay/toggle are trapped in its stacking context), so it is
    never occluded while scrolled. Non-blocking: no backdrop, the page keeps
    scrolling and the focus stays in the form.
  - Both icons (check + alert) are always in the markup; the inactive variant's
    icon is hidden via CSS \`group-data-[variant=...]\` hooks resolved from the
    root's \`data-variant\` (group class on the root) — no JS DOM manipulation of
    the icons.
  - Colors come from the design tokens of the success/error scales
    (\`bg-success-light\`, \`text-success-dark\`, \`bg-error-light\`,
    \`text-error-dark\`) — no raw hex in the markup. Flat design: 1px border, no
    rounded corners, no shadows.
  - The close button is a plain \`type="button"\` (never submits a form) with a
    descriptive \`aria-label\` and a decorative lucide:x icon; its click is
    handled by document-level delegation (see formToastClient).
--><div data-form-toast data-variant="success" data-state="hidden" hidden role="status" aria-live="polite" class="group fixed top-6 right-6 z-40 flex w-[min(calc(100%_-_3rem),24rem)] items-start gap-3 border px-4 py-3 font-body text-sm text-text-2 data-[variant=success]:border-success data-[variant=success]:bg-success-light data-[variant=error]:border-error data-[variant=error]:bg-error-light" data-astro-cid-hyvcqdav><svg width="1em" height="1em" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 group-data-[variant=success]:text-success-dark group-data-[variant=error]:hidden" aria-hidden="true" data-astro-cid-hyvcqdav="true" data-icon="lucide:circle-check"><symbol id="ai:lucide:circle-check"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m16 9l-5.5 5.5L8 12"/></g></symbol><use href="#ai:lucide:circle-check"></use></svg><svg width="1em" height="1em" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 group-data-[variant=error]:text-error-dark group-data-[variant=success]:hidden" aria-hidden="true" data-astro-cid-hyvcqdav="true" data-icon="lucide:circle-alert"><symbol id="ai:lucide:circle-alert"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></g></symbol><use href="#ai:lucide:circle-alert"></use></svg><p data-toast-message class="flex-1 py-0.5" data-astro-cid-hyvcqdav></p><button type="button" aria-label="Cerrar notificación" data-toast-close class="shrink-0 p-1 text-text-2 transition-colors hover:text-secondary" data-astro-cid-hyvcqdav><svg width="1em" height="1em" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" data-astro-cid-hyvcqdav="true" data-icon="lucide:x"><symbol id="ai:lucide:x"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></symbol><use href="#ai:lucide:x"></use></svg></button></div></div>"
`;
