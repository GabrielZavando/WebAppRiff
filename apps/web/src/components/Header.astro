---
import type { HeaderProps } from '@/lib/types/header';
import { isActive } from '@/lib/config/navigation';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logoImage from '@/assets/img/logo-web.webp';

interface Props extends HeaderProps {
  /** Transparent background on the home hero so the full-bleed image shows
   * through the shell (default solid navy gradient). */
  transparent?: boolean;
}

const { items, activePath, cta, logoAlt, transparent = false } = Astro.props;

// `logoAlt` is optional in the props contract; the image component requires a
// non-null alt, so we fall back to the brand name (type contract in
// lib/types/header.ts).
const logoAltText = logoAlt ?? 'Riff';
---

<!-- Main site header: logo, desktop navigation, quote CTA and mobile toggle. -->
<header
  class:list={[
    'text-white',
    transparent ? 'bg-transparent' : 'bg-linear-to-r from-secondary to-secondary-light',
  ]}
>
  <div class="container mx-auto px-4 h-24 flex items-center justify-between gap-4">
    <a href="/" aria-label="Ir al inicio" class="shrink-0">
      <!-- TODO[site-header-scroll-animations]: logo shrinks on scroll in a future change -->
      <Image
        src={logoImage}
        alt={logoAltText}
        width={165}
        height={67}
        class="h-auto w-[165px]"
      />
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
      {
        items.map((item) => {
          const active = isActive(item.href, activePath);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`px-3 py-2 text-xs font-heading font-semibold uppercase tracking-wide transition-colors relative ${
                active
                  ? 'text-white after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-0.5 after:bg-primary'
                  : 'text-white/80 hover:text-white'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a
      href={cta.href}
      class="hidden sm:inline-flex items-center bg-accent hover:bg-accent-dark text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 transition-colors whitespace-nowrap"
    >
      {cta.label}
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="lg:hidden p-2 text-white"
    >
      <Icon name="lucide:menu" class="h-6 w-6" />
      <Icon name="lucide:x" class="h-6 w-6 hidden" />
    </button>
  </div>

  <div
    id="mobile-nav"
    hidden
    class:list={[
      'lg:hidden border-t border-white/10 px-4 py-4',
      transparent ? 'bg-transparent' : 'bg-secondary-light',
    ]}
  >
    <nav aria-label="Navegación móvil" class="flex flex-col gap-2">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href, activePath) ? 'page' : undefined}
            class="px-3 py-2 font-heading font-semibold text-white/90 hover:bg-white/10"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  // Toggles the mobile navigation panel: swaps aria-expanded, the accessible
  // label and the visible icon, and shows/hides the panel.
  document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      button.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');

      const panel = document.getElementById(button.getAttribute('aria-controls') || '');
      if (panel) {
        panel.toggleAttribute('hidden');
      }

      button.querySelectorAll('svg').forEach((icon) => icon.classList.toggle('hidden'));
    });
  });
</script>