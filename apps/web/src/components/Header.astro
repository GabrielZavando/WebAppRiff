---
import type { HeaderProps } from '@/lib/types/header';
import { isActive } from '@/lib/config/navigation';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logoImage from '@/assets/img/logo-web.png';

interface Props extends HeaderProps {
  /** Transparent background on the home hero so the full-bleed image shows
   * through the shell (default solid bg-secondary, uniform with the search
   * bar — SC-001; the old navy gradient was removed). */
  transparent?: boolean;
}

const { items, activePath, cta, logoAlt, transparent = false } = Astro.props;

// `logoAlt` is optional in the props contract; the image component requires a
// non-null alt, so we fall back to the brand name (type contract in
// lib/types/header.ts).
const logoAltText = logoAlt ?? 'Riff';
---

<!-- Main site header: logo (2x with overflow), right-aligned desktop nav with
     CTA as the last item, and a fullscreen mobile overlay with slide animation.
     `pb-4 lg:pb-2` is more compact than the previous `pb-10 lg:pb-4`: mobile
     keeps 80px (h-16) + 16px (pb-4) = 96px vs ~80px logo at the 160px cap (full
     containment); desktop relaxes to 96px (lg:h-20) + 8px (lg:pb-2) = 104px vs
     ~121px logo at the 240px cap — a smaller visual overflow of the 2× logo on
     desktop, explicitly accepted by the client (SC-001). -->
<header
  data-menu-open="false"
  class:list={[
    'site-header',
    'text-white',
    'pb-4 lg:pb-2',
    // Short viewports (e.g. 568x320 landscape) collapse the vertical rhythm so
    // the sticky group (header + search) fits the viewport-height budget.
    '[@media(max-height:400px)]:pb-0',
    transparent ? 'bg-transparent' : 'bg-secondary',
  ]}
>
  <div class="site-header__inner container mx-auto px-4 h-16 lg:h-20 flex items-center justify-between gap-4 [@media(max-height:400px):h-12]">
    <!-- Logo: rendered at 2x (330x166), overflow-visible so the header
         container (h-24) does not grow -- the logo may visually extend
         beyond the header height without displacing sibling elements. -->
     <a href="/" aria-label="Ir al inicio" class="shrink-0 h-16 lg:h-20 overflow-visible [@media(max-height:400px):h-12] [@media(max-height:400px)]:max-w-[100px]">
      <!-- Logo: responsive max-width so it scales proportionally — 160px cap
           on mobile, 240px cap from the sm breakpoint upward. `w-full` lets it
           fill available width up to the cap while the `width`/`height` attrs
           (330×166) preserve the aspect ratio for CLS. The wrapper is
           `h-20 lg:h-24 overflow-visible`. `max-h-full` caps the logo to the
           header height on small screens so it can never grow the header;
           dropped at `sm:max-h-none` (≥640px) so the desktop compact state can
           keep the logo at its 100px-tall contract (LOGO-SIZE) across the whole
           ≥640px range — the header may then visually overflow (2× pattern). -->
      <Image
        src={logoImage}
        alt={logoAltText}
        width={330}
        height={166}
        class="site-logo block h-auto w-full max-w-[160px] sm:max-w-[240px] sm:max-h-none"
      />
    </a>

    <!-- Desktop nav: right-aligned (ml-auto), includes the CTA as the last item.
         The CTA keeps its bg-accent styling; only the old standalone visibility
         utility (hidden sm:inline-flex) is removed since the nav's own
         responsive classes now control visibility. -->
    <nav aria-label="Navegación principal" class="hidden xl:flex items-center gap-1 lg:gap-0.5 xl:gap-1 ml-auto">
      {
        items.map((item) => {
          const active = isActive(item.href, activePath);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'px-3 py-2 text-xs font-heading font-semibold uppercase tracking-wide transition-colors relative',
                active
                  ? 'text-white after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-[3px] after:bg-primary'
                  : 'text-white/80 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <!-- CTA as the last nav item: styles unchanged (bg-accent), now inside the <nav>. -->
      <a
        href={cta.href}
        class="inline-flex items-center bg-accent hover:bg-accent-dark text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 transition-colors whitespace-nowrap"
      >
        {cta.label}
      </a>
    </nav>

    <!-- Mobile toggle: fixed so it is always visible above the fullscreen
         overlay (z-50 > overlay z-40). Icon color adapts via CSS driven by
         data-menu-open on <header>: white on the solid secondary header
         (closed), secondary on white overlay (open). -->
    <button
      type="button"
      data-menu-toggle
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="fixed top-6 right-6 z-50 xl:hidden p-2 transition-colors duration-200"
    >
      <Icon name="lucide:menu" class="h-6 w-6" />
      <Icon name="lucide:x" class="h-6 w-6 hidden" />
    </button>
  </div>

  <!-- Mobile menu: fullscreen overlay (100vw x 100vh) with white background.
       Slides in from the right via CSS transform driven by data-menu-open on
       the <header>. Shows only the menu items + CTA. -->
  <div
    id="mobile-nav"
    class="fixed inset-0 bg-white z-40 xl:hidden flex flex-col items-center justify-center gap-8 transition-transform duration-300 ease-in-out"
  >
    <nav aria-label="Navegación móvil" class="flex flex-col items-center justify-center gap-6">
      {
        items.map((item) => {
          const active = isActive(item.href, activePath);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'font-heading font-semibold text-base transition-colors relative',
                active
                  ? 'text-primary after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-[3px] after:bg-primary'
                  : 'text-secondary hover:text-primary',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <!-- CTA as the last mobile nav item: same bg-accent styling. -->
      <a
        href={cta.href}
        class="inline-flex items-center bg-accent hover:bg-accent-dark text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 transition-colors whitespace-nowrap"
      >
        {cta.label}
      </a>
    </nav>
  </div>
</header>

<!-- CSS state rules: data-menu-open attribute drives the overlay slide
     transform and the toggle button color. Scoped via is:inline (no global
     side effects). -->
<style is:inline>
  header[data-menu-open="false"] #mobile-nav {
    transform: translateX(100%);
    pointer-events: none;
  }
  header[data-menu-open="true"] #mobile-nav {
    transform: translateX(0);
    pointer-events: auto;
  }
  /* Toggle button: white on solid secondary header (closed) -> secondary on white overlay (open) */
  header[data-menu-open="false"] [data-menu-toggle] {
    color: var(--color-white);
  }
  header[data-menu-open="true"] [data-menu-toggle] {
    color: var(--color-secondary);
    background-color: var(--color-white);
  }
</style>

<script is:inline>
  // Toggles the mobile navigation overlay:
  // - aria-expanded/aria-label on the toggle button (accessibility)
  // - data-menu-open on the header element (drives CSS: panel slide, button color)
  // - body scroll lock (prevents scroll-through on fullscreen overlay)
  document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      const newState = !isOpen;

      button.setAttribute('aria-expanded', String(newState));
      button.setAttribute('aria-label', newState ? 'Cerrar menú' : 'Abrir menú');

      const header = button.closest('header');
      if (header) {
        header.setAttribute('data-menu-open', String(newState));
        document.body.style.overflow = newState ? 'hidden' : '';
      }

      // Swap hamburger <-> X icon
      button.querySelectorAll('svg').forEach((icon) => icon.classList.toggle('hidden'));
    });
  });
</script>
