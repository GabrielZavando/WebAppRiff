---
import { Image } from 'astro:assets';
import type { RepresentacionBrand } from '@/lib/types/representaciones-page';

interface Props extends RepresentacionBrand {}

const { logo, url, chip, sublabel, title, category, description } = Astro.props;
---

<!--
  Brand card for the "Marcas de Representación Exclusiva" section
  (design.md § D1/D2/D4). Left panel (md:w-64) holds the real brand logo
  (astro:assets <Image>, WebP in build) inside a `data-brand-logo` container.
  When the brand defines `url` (change `web-content-and-ui-polish`), the logo
  image — and only the image — is wrapped in an external link
  (`target="_blank"` + `rel="noopener noreferrer"`); brands without `url`
  (GL Flow) render the logo without a link. Buttons/cards stay flat: bg-white,
  border-border, no rounded-*, no shadow-*.
-->
<article
  data-brand-card
  class="bg-white border border-border flex flex-col md:flex-row items-start md:items-center gap-6 p-6 md:p-8"
>
  <div
    class="w-full md:w-64 bg-bg p-6 flex flex-col justify-center items-start shrink-0"
    data-brand-logo
  >
    <span
      class="bg-primary text-white font-heading text-xs font-semibold px-2 py-0.5 uppercase tracking-wider mb-2"
    >
      {chip}
    </span>
    {
      url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full max-w-[192px]"
        >
          <Image
            src={logo}
            alt={title}
            widths={[128, 256]}
            sizes="(max-width: 768px) 50vw, 256px"
            loading="lazy"
            class="h-auto w-full max-w-[192px] object-contain"
          />
        </a>
      ) : (
        <Image
          src={logo}
          alt={title}
          widths={[128, 256]}
          sizes="(max-width: 768px) 50vw, 256px"
          loading="lazy"
          class="h-auto w-full max-w-[192px] object-contain"
        />
      )
    }
    <span class="font-body text-xs text-text-2 mt-2">{sublabel}</span>
  </div>
  <div class="flex-1 flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-3">
      <h3 class="font-heading text-xl font-bold text-text">{title}</h3>
      <span class="text-border">|</span>
      <span class="font-heading text-xs font-semibold text-primary">
        {category}
      </span>
    </div>
    <p class="font-body text-text-2 leading-relaxed max-w-3xl">
      {description}
    </p>
  </div>
</article>
