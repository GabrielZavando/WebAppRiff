---
import type { PanelHomeProps } from '@/lib/types/panel-home';

interface Props extends PanelHomeProps {}

const { eyebrow, headline, description, cta, stats } = Astro.props;
---

<!--
  Dumb presentational component. All content (eyebrow, headline, description,
  CTA and the 4 stats) comes via props spread from `PANEL_HOME_CONTENT` in
  `lib/config/panel-home.ts` by `apps/web/src/pages/index.astro`.

  Layout (see design.md § Decisions 2, 4, 11, 12, 16, 17):
    - Outermost <section> stays full-width and carries `relative` + `z-10`. On
      mobile/tablet it uses a small negative margin-top (`-mt-2 md:-mt-2`) so the
      panel overlaps the HeroBanner above it by 8px; on desktop it uses a positive
      margin-top (`lg:mt-2`, 8px) so the panel sits 8px BELOW the banner (no
      overlap) — a positive margin seats the panel lower than a negative one.
    - Inner `<div class="container mx-auto px-4 sm:px-6 lg:px-8">` constrains the
      visible panel (teal+white) to the same max-width as the SearchForm (token
      `.container` in globals.css), making the panel "float" over the banner and
      aligning it with the rest of the site grid (design.md Decision 12).
    - `grid grid-cols-1 lg:grid-cols-2` main grid stacks on mobile (< 1024px),
      side-by-side on desktop (>= 1024px).
    - Left half (bg-primary): eyebrow, <h2> headline, description <p>, CTA <a>.
    - Right half (bg-white): a flex column (`flex flex-col`) that stretches to
      the height of the teal half (its sibling in the main grid) via
      `align-items: stretch` on `grid-cols-1 lg:grid-cols-2`. Inside, a
      `relative stats-grid-wrap flex-1` fills that height; the 2x2 grid uses
      `grid-cols-2 grid-rows-2 gap-px h-full w-full` and the wrap carries
      `background-color: var(--color-primary)` (scoped class) so the 1px gap
      exposes the primary colour as edge-to-edge divider lines that reach
      the actual top and bottom of the white half (TERNION). Each cell
      carries `bg-white p-8 md:p-12 flex flex-col justify-center` and
      renders a <p> value (navy bold) and <p> label (uppercase gray) — NO
      headings.

  Accessibility (see design.md § Decision 6):
    - The panel headline is a <h2>, NOT a <h1> (the home page has exactly one
      <h1> and the HeroBanner owns it). No <h3>/<h4> are introduced inside the
      panel so the document outline stays clean.
    - The eyebrow is a <span> (decorative, uppercase), NOT a heading.
    - The stat values/labels are <p> elements, NOT headings.
-->
<section class="relative -mt-2 md:-mt-2 lg:mt-2 z-10" data-panel-home>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 panel-home-elevated" data-panel-card>
      <!--
        Left half — teal background with copy and the navy CTA. The CTA is
        navy (not teal) so it contrasts against the panel background (design.md
        § Decision 5). Description opacity is `text-white/80`; E2E contrast
        tests may bump it to `text-white/90` or `text-white` to meet WCAG AA
        Normal on the teal background (see design.md § Decision 10 post-apply
        update — TODO pending the `design-system-revision` change).
      -->
      <div class="bg-primary p-8 md:p-12 lg:p-12">
        <span class="block text-xs font-heading font-semibold uppercase tracking-wider text-white/80">
          {eyebrow}
        </span>
        <h2 class="mt-3 text-2xl md:text-3xl lg:text-4xl font-heading font-bold text-white">
          {headline}
        </h2>
        <p class="mt-4 text-white/80 max-w-md">
          {description}
        </p>
        <a
          href={cta.href}
          class="mt-6 inline-block bg-secondary text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 hover:bg-secondary-light transition-colors"
        >
          {cta.label}
        </a>
      </div>

      <!--
        Right half — white background with a 2x2 stats grid. The grid stays
        at `grid-cols-2` on every viewport (design.md § Decision 3); the stat
        values are short enough that they don't break at 320px (validated by
        E2E 4.6).

        Padding lives on the cells, not on the wrapper, so the 1px primary
        divider lines (formed by `gap-px` + the scoped `bg-primary` colour on
        the wrap, with `bg-white` cells covering the rest) span edge-to-edge
        of the white half of the panel. The wrapper uses `flex-1` (and the
        outer `bg-white` is `flex flex-col`) so it stretches to the full
        height of the white half — guaranteeing the vertical divider line
        reaches top and bottom.
      -->
      <div class="bg-white flex flex-col">
        <div class="relative stats-grid-wrap flex-1">
          <div class="grid grid-cols-2 grid-rows-2 gap-px h-full w-full">
            {
              stats.map((stat) => (
                <div class="bg-white p-8 md:p-12 flex flex-col justify-center">
                  <p
                    class="text-3xl md:text-4xl font-heading font-bold text-secondary"
                    data-stat-value=""
                    data-target={stat.numericValue}
                  >
                    {stat.value}
                  </p>
                  <p class="mt-2 text-xs md:text-sm uppercase tracking-wide text-text-2">
                    {stat.label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Elevation: the teal+white card (the main `grid-cols-1 lg:grid-cols-2`
     panel) floats over the HeroBanner below it. Documented flat-design
     exception (see style guide + design.md TERNION). */
  .panel-home-elevated {
    box-shadow: var(--shadow-scroll-shell);
  }

  /* The stats grid wrapper carries the primary colour behind a `gap-px` grid
     so the 1px gap exposes it as edge-to-edge divider lines between white
     cells (TERNION). Kept as a scoped class (rather than the `bg-primary`
     utility) so pre-existing E2E locators like `div.bg-primary` continue to
     match only the left teal half. */
  .stats-grid-wrap {
    background-color: var(--color-primary);
  }
</style>

<script>
  import { initCounterAnimation } from '@/lib/anim/createCounterAnimation';

  // Animate the stat counters once, the first time they scroll into view.
  const statElements = Array.from(
    document.querySelectorAll<HTMLElement>('[data-stat-value]'),
  );

  if (statElements.length > 0) {
    initCounterAnimation({ elements: statElements });
  }
</script>
