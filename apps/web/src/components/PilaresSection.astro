---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { PilaresSectionProps } from '@/lib/types/pilares-section';

interface Props extends PilaresSectionProps {}

const {
  eyebrow,
  headline,
  description,
  cta,
  rightEyebrow,
  rightHeadline,
  rightDescription,
  pillars,
  leftImage,
  leftImageAlt,
} = Astro.props;
---

<!--
  Dumb presentational component. All content (copy, CTA, pillars, background
  image) comes via props spread from `PILARES_SECTION_CONTENT` in
  `lib/config/pilares-section.ts` by `apps/web/src/pages/index.astro`.

  Layout (see design.md § Decisions 2, 3, 4, 7):
    - Outermost <section> is full-bleed (NO `container` wrapper, NO bg token):
      the two columns cover the full viewport width edge-to-edge.
    - `grid grid-cols-1 lg:grid-cols-2` stacks on mobile, splits 50/50 at the
      `lg` breakpoint.
    - LEFT column is `relative`: absolute background <Image> (astro:assets,
      object-cover) + color overlay `bg-secondary/80` (navy #1F2D40) +
      `relative z-10` content with internal padding (design.md § Decision 3,
      POST-APPLY FIX #1 2026-08-09).
    - RIGHT column is a flat solid `bg-primary-deep` block (teal #006874, no
      photo, no overlay — design.md § Decision 3, POST-APPLY FIX #2 2026-08-09:
      the client replaced the `planta-tratamiento-ecologica.webp` photo with
      the solid color because "no se ve nada de bien").
    - Left column heading is a <h2> (sibling of PanelHome's <h2>; there is
      exactly one <h1> on the home owned by HeroBanner — design.md § Decision 4).
    - Right column has its own eyebrow `rightEyebrow` ("Estándares de Calidad",
      `text-primary` — POST-APPLY FIX #2) and heading <h3> (subordinate
      portfolio section, like SolutionSection/ServicesSection/DestacadosSection).
    - Pillar icons are Lucide via astro-icon, decorative (aria-hidden),
      `text-primary` colored over the solid teal background (design.md §
      Decision 7, POST-APPLY FIX #2).

  Accessibility:
    - Eyebrows are <span>s (decorative, uppercase), NOT headings.
    - Pillar labels are <span> elements, NOT headings (they are list rows, not
      document subsections — the right column owns the only <h3>).
    - Background image is decorative but carries descriptive alt text
      (frontend-standards § "Imágenes del sitio").
-->

<section class="grid grid-cols-1 lg:grid-cols-2">
  <!-- Left column — value proposition over the edificio photo -->
  <div class="relative">
    <Image
      src={leftImage}
      alt={leftImageAlt}
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-secondary/80"></div>
    <div class="relative z-10 p-8 md:p-12 lg:p-16">
      <span
        class="block text-xs font-heading font-semibold uppercase tracking-wider text-accent"
      >
        {eyebrow}
      </span>
      <h2
        class="mt-3 text-2xl md:text-3xl lg:text-4xl font-heading font-bold text-white"
      >
        {headline}
      </h2>
      <p class="mt-4 text-white/80 max-w-md">
        {description}
      </p>
      <a
        href={cta.href}
        class="mt-6 inline-block bg-accent text-white font-heading font-semibold uppercase text-xs tracking-wide px-6 py-3 hover:bg-accent-dark transition-colors"
      >
        {cta.label}
      </a>
    </div>
  </div>

  <!-- Right column — pillars of excellence over solid primary-deep -->
  <div class="bg-primary-deep p-8 md:p-12 lg:p-16">
    <span
      class="block text-xs font-heading font-semibold uppercase tracking-wider text-primary"
    >
      {rightEyebrow}
    </span>
    <h3
      class="mt-3 text-2xl md:text-3xl lg:text-4xl font-heading font-bold text-white"
    >
      {rightHeadline}
    </h3>
    <p class="mt-4 text-white/80 max-w-md">
      {rightDescription}
    </p>
    <div class="mt-8 space-y-5">
      {
        pillars.map((pilar) => (
          <div class="flex items-center gap-4">
            <Icon
              name={`lucide:${pilar.icon}`}
              class="h-6 w-6 text-primary shrink-0"
              aria-hidden="true"
            />
            <span class="font-heading text-white">{pilar.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>