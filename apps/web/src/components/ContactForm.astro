---
import type { ContactFormProps } from '@/lib/types/contact-form';
import { Icon } from 'astro-icon/components';

interface Props extends ContactFormProps {}

const { areas, config } = Astro.props;
const { placeholders, submitLabel, action } = config;

// Deterministic ids for label↔control association. There is exactly one
// ContactForm per page (the /contacto page), so these ids stay unique within
// the document and the `for`/`id` bindings remain valid.
const fieldIds = {
  nombre: 'contact-nombre',
  empresa: 'contact-empresa',
  email: 'contact-email',
  telefono: 'contact-telefono',
  mensaje: 'contact-mensaje',
} as const;

// Stable, readable per-area checkbox id derived from the area slug. The label
// `for` references it so each checkbox is programmatically associated.
function areaInputId(areaId: string): string {
  return `contact-area-${areaId}`;
}

// Label text for the four text inputs. Uppercase by design (flat, technical
// aesthetic consistent with the mockup). The placeholder carries the hint.
const inputLabels = {
  nombre: 'NOMBRE COMPLETO',
  empresa: 'EMPRESA',
  email: 'CORREO ELECTRÓNICO',
  telefono: 'TELÉFONO',
} as const;
---

<!--
  Dumb presentational component for the contact page form. All content (areas,
  copy, placeholders, action) comes via props spread from
  `CONTACT_PAGE_CONTENT.form` by `apps/web/src/pages/contacto.astro`.

  Layout:
    - Outermost <form method="post" action={config.action}> (native HTML
      submit; the future backend endpoint `POST /api/v1/contacts` consumes it).
    - Text inputs grid `grid-cols-1 md:grid-cols-2` (mobile stacked, desktop
      two columns): Nombre | Empresa, Email | Teléfono.
    - Areas of interest: a single <fieldset> with <legend> "ÁREA DE INTERÉS"
      wrapping 5 checkboxes in a `grid-cols-1 sm:grid-cols-2` grid. Each
      checkbox has an associated <label> via `for`/`id`.
    - Message: full-width <textarea> with associated <label>.
    - Submit: <button type="submit"> with accent token + decorative arrow icon.

  Accessibility: every control has a visible <label> associated via `for`/`id`;
  checkboxes are grouped in a fieldset/legend; the button relies on its visible
  text (no extra aria-label). Native HTML5 validation (`required`, `type`) is
  used so the form is operable without JavaScript.

  Strict flat design: no `rounded*` and no `shadow*` in the static state.
-->
<div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-0">
  <!-- White box spanning the full page content width (same container/side
       margins as the site header). Flat design: 1px border, no shadow, no
       rounded corners. -->
  <form method="post" action={action} class="bg-white border border-border">
    <div class="px-6 py-10 md:px-10 md:py-12">
      <!-- Header -->
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-secondary">
        Solicitud de Contacto Técnico
      </h2>
      <p class="mt-2 font-body text-sm text-text-2">
        Complete el formulario y nuestro equipo de ingenieros se pondrá en
        contacto con usted a la brevedad.
      </p>

      <!-- Text inputs: mobile stacked, desktop two columns -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
        <div>
          <label
            for={fieldIds.nombre}
            class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary"
          >
            {inputLabels.nombre}
          </label>
          <input
            id={fieldIds.nombre}
            name="nombre"
            type="text"
            required
            placeholder={placeholders.nombre}
            class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"
          />
        </div>

        <div>
          <label
            for={fieldIds.empresa}
            class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary"
          >
            {inputLabels.empresa}
          </label>
          <input
            id={fieldIds.empresa}
            name="empresa"
            type="text"
            required
            placeholder={placeholders.empresa}
            class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"
          />
        </div>

        <div>
          <label
            for={fieldIds.email}
            class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary"
          >
            {inputLabels.email}
          </label>
          <input
            id={fieldIds.email}
            name="email"
            type="email"
            required
            placeholder={placeholders.email}
            class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"
          />
        </div>

        <div>
          <label
            for={fieldIds.telefono}
            class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary"
          >
            {inputLabels.telefono}
          </label>
          <input
            id={fieldIds.telefono}
            name="telefono"
            type="tel"
            required
            placeholder={placeholders.telefono}
            class="mt-2 w-full h-11 border border-border bg-bg px-3 text-sm text-text-2 focus:outline-none focus:border-primary"
          />
        </div>
      </div>

      <!-- Areas of interest: fieldset + legend, two-column checkbox grid -->
      <fieldset class="mt-8">
        <legend class="font-heading text-xs font-semibold uppercase tracking-wider text-secondary">
          ÁREA DE INTERÉS
        </legend>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          {
            areas.map((area) => (
              <div class="flex items-center gap-2">
                <input
                  id={areaInputId(area.id)}
                  name="areasDeInteres"
                  type="checkbox"
                  value={area.id}
                  class="h-4 w-4 border border-border text-primary focus:outline-none focus:border-primary accent-primary"
                />
                <label
                  for={areaInputId(area.id)}
                  class="font-body text-sm text-text-2"
                >
                  {area.label}
                </label>
              </div>
            ))
          }
        </div>
      </fieldset>

      <!-- Message textarea -->
      <div class="mt-8">
        <label
          for={fieldIds.mensaje}
          class="block font-heading text-xs font-semibold uppercase tracking-wider text-secondary"
        >
          MENSAJE O REQUERIMIENTO ESPECÍFICO
        </label>
        <textarea
          id={fieldIds.mensaje}
          name="mensaje"
          required
          placeholder={placeholders.mensaje}
          rows="5"
          class="mt-2 w-full border border-border bg-bg px-3 py-2 text-sm text-text-2 focus:outline-none focus:border-primary"
        ></textarea>
      </div>

      <!-- Submit: full width, text left, arrow icon right -->
      <div class="mt-8">
        <button
          type="submit"
          class="flex w-full items-center justify-center gap-3 px-8 py-3 font-heading font-semibold uppercase text-xs tracking-wide bg-accent hover:bg-accent-dark text-white transition-colors"
        >
          <span>{submitLabel}</span>
          <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>
    </div>
  </form>
</div>
