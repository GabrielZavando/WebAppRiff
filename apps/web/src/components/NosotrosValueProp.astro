---
import type {
  NosotrosValuePropProps,
  PillarIconTone,
} from '@/lib/types/nosotros-page';
import { Icon } from 'astro-icon/components';

interface Props extends NosotrosValuePropProps {}

const {
  eyebrow,
  title,
  description,
  sideNote,
  pillars,
  sectorsEyebrow,
  sectorsTitle,
  sectors,
} = Astro.props;

/** Icon tile colors per pillar tone (design.md D4): deep teal vs accent. */
const PILLAR_TONES: Record<PillarIconTone, string> = {
  primary: 'bg-primary-deep text-white',
  accent: 'bg-accent text-white',
};
---

<!--
  Dumb presentational component for the /nosotros value proposition
  (section 3 of the approved reference, SC-204): the verbatim header + side
  note, four value pillars (icon tile, title, body and footnote strip) and
  the "Campos de Acción" bento with four industry-sector cards.

  Layout (design.md § Decisions 4/10/11/12):
    - Header row: 8/12 columns of copy + 4/12 side-note chip.
    - Pillars and sectors both collapse 1 → 2 → 4 columns (SC-211).
    - Lucide icons are decorative (`aria-hidden="true"`, SC-209); pillar
      tiles use `bg-primary-deep`/`bg-accent` by tone; sector icons anchor
      bottom-right in `text-primary`.
    - Flat design: no `rounded*`, no hex literals; only the sector cards
      carry the content shadow token `shadow-1` (design.md D11).
    - Heading hierarchy: section `<h2>`, pillar `<h3>`, sector `<h4>`.
-->
<section class="w-full bg-white py-16 md:py-20">
  <div class="container mx-auto">
    <div class="mb-16 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <div
          class="mb-1 inline-flex items-center gap-1 font-heading text-sm font-semibold uppercase tracking-wider text-accent"
        >
          <span class="h-0.5 w-8 bg-accent"></span>
          <span>{eyebrow}</span>
        </div>
        <h2 class="font-heading text-2xl uppercase tracking-tight text-text md:text-3xl"
          >{title}</h2
        >
        <p class="mt-2 font-body text-lg leading-relaxed text-text-2"
          >{description}</p
        >
      </div>
      <div class="flex items-end justify-start lg:col-span-4 lg:justify-end">
        <div
          class="bg-primary-100 p-4 font-heading text-xs font-semibold uppercase tracking-wider text-text"
        >
          {sideNote}
        </div>
      </div>
    </div>

    <div class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((pillar) => (
          <div class="flex flex-col justify-between bg-bg p-8 transition-colors hover:bg-primary-100">
            <div>
              <div
                class={`mb-4 flex h-12 w-12 items-center justify-center ${PILLAR_TONES[pillar.iconTone]}`}
              >
                <Icon
                  name={`lucide:${pillar.icon}`}
                  class="h-6 w-6"
                  aria-hidden="true"
                />
              </div>
              <h3 class="mb-1 font-heading text-xl text-text">{pillar.title}</h3>
              <p class="font-body text-base text-text-2">{pillar.description}</p>
            </div>
            <div class="mt-4 bg-primary-100/40 p-2 pt-4 font-body text-xs text-text">
              {pillar.note}
            </div>
          </div>
        ))
      }
    </div>

    <div class="bg-primary-100 p-8">
      <div class="mb-8 max-w-2xl">
        <span
          class="block font-heading text-sm font-semibold uppercase tracking-wider text-primary"
          >{sectorsEyebrow}</span
        >
        <h3 class="font-heading text-2xl uppercase tracking-tight text-text md:text-3xl"
          >{sectorsTitle}</h3
        >
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          sectors.map((sector) => (
            <div class="flex flex-col justify-between bg-white p-4 shadow-1">
              <div>
                <div class="mb-1 font-heading text-xs font-semibold text-accent">
                  {sector.label}
                </div>
                <h4 class="mb-1 font-heading text-sm font-semibold uppercase text-text">
                  {sector.title}
                </h4>
                <p class="font-body text-xs leading-relaxed text-text-2">
                  {sector.description}
                </p>
              </div>
              <Icon
                name={`lucide:${sector.icon}`}
                class="mt-2 h-5 w-5 self-end text-primary"
                aria-hidden="true"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
