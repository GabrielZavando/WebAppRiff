---
import type { RepresentacionesHeroContent } from '@/lib/types/representaciones-page';
import { splitHeadline } from '@/lib/config/hero-banner';

interface Props extends RepresentacionesHeroContent {}

const { eyebrow, headline, highlightedWord, intro, metrics } = Astro.props;

// Same highlight helper as HeroBanner/ServicesHero (pure, testable). When the
// word is absent or empty, `after === ""` and the highlighted span is skipped.
const [before, after] = splitHeadline(headline, highlightedWord);
const shouldRenderHighlight = highlightedWord !== '' && before !== headline;

// Value tone tokens remapped from the Stitch palette (design.md § D5).
const metricToneClass: Record<
  RepresentacionesHeroContent['metrics'][number]['valueTone'],
  string
> = {
  primary: 'text-primary',
  accent: 'text-accent',
  surface: 'text-white',
};
---

<!--
  Editorial hero for /representaciones (design.md § D4/D5). Dark brand navy
  (`bg-secondary`) band with an optional decorative technical grid, an eyebrow,
  an <h1> whose highlight is wrapped in `text-primary`, an intro paragraph and
  exactly three metric cards. The grid is a CSS token-based pattern (design.md
  § D8) — no inline SVG, no raw hex. Strict flat design: no rounded-*, no
  shadow-*.
-->
<section class="relative w-full bg-secondary text-white overflow-hidden">
  <div
    class="technical-grid pointer-events-none absolute inset-0 opacity-10"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-[1280px] px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-accent"></span>
          <span
            class="font-heading text-xs font-semibold uppercase tracking-widest text-accent"
          >
            {eyebrow}
          </span>
        </div>
        <h1
          class="font-heading font-bold uppercase tracking-tight leading-none text-4xl md:text-5xl lg:text-6xl text-white"
        >
          {before}{shouldRenderHighlight && <span class="text-primary">{highlightedWord}</span>}{after}
        </h1>
        <p class="font-body text-base md:text-lg text-white/80 max-w-2xl leading-relaxed">
          {intro}
        </p>
      </div>
      <div class="lg:col-span-5">
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-3">
          {
            metrics.map((metric) => (
              <div
                data-metric
                class="bg-white/5 p-5 flex flex-col justify-between"
              >
                <span
                  class:list={[
                    'font-heading font-bold text-3xl leading-none',
                    metricToneClass[metric.valueTone],
                  ]}
                >
                  {metric.value}
                </span>
                <span class="font-heading text-xs font-bold uppercase tracking-wider text-white mt-2">
                  {metric.label}
                </span>
                <span class="font-body text-xs text-white/60 mt-0.5">
                  {metric.caption}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
