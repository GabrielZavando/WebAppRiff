---
import type { ServicesHeroProps } from '@/lib/types/services-page';
import { splitHeadline } from '@/lib/config/hero-banner';

interface Props extends ServicesHeroProps {}

const { headline, highlightedWord, subtitle } = Astro.props;

// Pure helper extracted to lib/config (same one used by HeroBanner and
// ContactHero) so the edge cases (word absent, word at start/end, multiple
// occurrences) are testable without mounting the component (frontend-standards
// § "Frontmatter sin lógica de negocio no trivial"). `before` + `after` are the
// text fragments around the single highlighted occurrence; when the word is
// absent or empty, `after === ""` and we skip rendering the highlighted <span>.
const [before, after] = splitHeadline(headline, highlightedWord);
const shouldRenderHighlight = highlightedWord !== '' && before !== headline;
---

<!--
  Dumb presentational component for the services page hero. All copy comes via
  props spread from SERVICIOS_PAGE_CONTENT.hero by pages/servicios.astro. The
  page passes the hero flag to Layout, so Layout renders the full-bleed home
  banner image plus a color overlay behind this transparent section. This
  component adds only the hero copy and its height; it must not set its own
  background (design.md Decision 3: hero identical to the home page). Single h1
  per page is preserved (this is the only h1 on /servicios); the subtitle is a p
  beneath it. Strict flat design: no rounded and no shadow in the static state.
  The highlighted word uses the accent token (design.md Decision 9).
-->
<section>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white max-w-4xl">
      {before}{shouldRenderHighlight && <span class="text-accent">{highlightedWord}</span>}{after}
    </h1>
    <p class="mt-6 text-base md:text-lg text-white/80 max-w-2xl font-body">
      {subtitle}
    </p>
  </div>
</section>
