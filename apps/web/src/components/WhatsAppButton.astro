---
// Global floating WhatsApp contact CTA — dumb presentational component: it
// receives the phone number via the `phone` prop and derives the wa.me href
// (digits only with country code). No business rules in the frontmatter.
// Full contract in the template comment below (SC-007 / SC-008 / SC-004).
import { Icon } from 'astro-icon/components';

interface Props {
  /** WhatsApp number (e.g. '+56 9 3752 6162'). Digits-only wa.me href is derived. */
  phone: string;
}

const { phone } = Astro.props;
---

<!-- WhatsAppButton — global floating WhatsApp CTA (SC-007 / SC-008):
     - Fixed at the bottom-right corner (`fixed bottom-6 right-6 z-20`):
       above page content (≤ z-10) and below the sticky header group z-30 and
       its mobile menu overlay — the overlay's z-40 is trapped inside the
       sticky shell's z-30 stacking context, so the FAB must be below z-30 to
       stay under the open menu (adversarial review finding, 2026-10-04).
     - Icon-only link to https://wa.me/{digits} derived from the `phone` prop
       (sourced from the `lib/config/contact.ts` constant `contact.whatsapp`,
       e.g. '+56 9 3752 6162' → digits only with country code),
       `target="_blank"` + `rel="noopener noreferrer"`.
       The accessible name lives in `aria-label`; the icon is decorative
       (`aria-hidden="true"`), so no visible text renders the number.
     - Colors use the design tokens `bg-whatsapp` / `hover:bg-whatsapp-dark`
       (declared in task 5.3) — no raw hex in the markup.
     - `simple-icons:whatsapp` is the second documented icon-set exception:
        Lucide provides no WhatsApp brand icon; precedent: `simple-icons:x`
        (see docs/design/style-guide/README.md).
     - Attention pulse (change `web-content-and-ui-polish`): a subtle infinite
        CSS-only scale pulse (see `<style>` below) grabs attention without
        JavaScript; it only animates GPU-friendly `transform`/`opacity` and is
        fully disabled under `prefers-reduced-motion: reduce` (same pattern as
        NosotrosClientsCarousel.astro). -->
<a
  href={`https://wa.me/${phone.replace(/\D/g, '')}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="whatsapp-fab fixed bottom-6 right-6 z-20 flex h-14 w-14 items-center justify-center bg-whatsapp transition-colors hover:bg-whatsapp-dark"
>
  <Icon name="simple-icons:whatsapp" class="h-7 w-7 text-white" aria-hidden="true" />
</a>

<style>
  /*
   * Subtle infinite attention pulse (scale only — transform/opacity are
   * GPU-composited and never affect layout, the fixed position or the
   * z-index). Cycle is slow (~2s) so it reads as a gentle breathing effect.
   */
  .whatsapp-fab {
    animation: whatsapp-fab-pulse 2s ease-in-out infinite;
  }

  @keyframes whatsapp-fab-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.08);
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
  }
</style>