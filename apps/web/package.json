{
  "name": "@riff/web",
  "version": "0.0.0",
  "private": true,
  "description": "Sitio público Astro SSG - Riff Catálogo Digital",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint -c .eslintrc.cjs \"src/**/*.{ts,astro}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test --project=chromium",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.6",
    "astro-icon": "^1.1.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "astro-eslint-parser": "^2.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
