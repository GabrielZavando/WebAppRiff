{
  "name": "@riff/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS BFF para Riff Catálogo Digital",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "bootstrap:superadmin": "nest build && node dist/cli/bootstrap-superadmin.js",
    "seed:catalog": "nest build && node dist/cli/seed-catalog.js",
    "seed:productos": "nest build && node dist/cli/seed-productos.js",
    "migrate:firestore": "nest build && node dist/cli/migrate-firestore.js",
    "migrate:productos:imagenes": "nest build && node dist/cli/migrate-imagenes.js",
    "migrate:descriptions": "nest build && node dist/cli/normalize-descriptions.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:smoke": "jest --testPathPattern=smoke",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/config": "^4.0.0",
    "@riff/html-sanitize": "*",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.0",
    "firebase-admin": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "sharp": "^0.35.3",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~6.0.0"
  }
}
