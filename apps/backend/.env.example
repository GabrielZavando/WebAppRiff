# Backend NestJS (apps/backend) — variables de entorno
#
# En este change (backend-scaffold) el backend solo lee PORT.
# Las variables de Firebase (FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL,
# FIREBASE_PRIVATE_KEY), CORS (ASTRO_SITE_URL, ANGULAR_ADMIN_URL) y Throttler
# se añaden en los changes siguientes (backend-firebase-config, backend-commons).

# Puerto en el que escucha la app. Default: 3000.
PORT=3000
