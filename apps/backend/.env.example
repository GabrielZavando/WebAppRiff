# Backend NestJS (apps/backend) — variables de entorno
#
# En backend-scaffold el backend solo leía PORT. En backend-firebase-config se
# añaden las credenciales de Firebase. CORS (ASTRO_SITE_URL, ANGULAR_ADMIN_URL)
# y Throttler se añaden en backend-commons.

# Puerto en el que escucha la app. Default: 3000.
PORT=3000

# =============================================================================
# FIREBASE (runtime via Application Default Credentials — ADC)
# =============================================================================
# El runtime del backend autentica contra Firebase Admin usando ADC
# (`applicationDefault()`): en Cloud Run resuelve la service account de runtime
# del servicio automáticamente; en local se obtiene con:
#   gcloud auth application-default login
# (o exportando GOOGLE_APPLICATION_CREDENTIALS=<path al JSON>).
# Por eso el runtime SOLO requiere estas dos variables:

FIREBASE_PROJECT_ID=riff-catalogo
FIREBASE_STORAGE_BUCKET=webappriff.firebasestorage.app

# -----------------------------------------------------------------------------
# Credenciales de service account (SOLO el CLI raw migrate:firestore)
# -----------------------------------------------------------------------------
# FIREBASE_CLIENT_EMAIL y FIREBASE_PRIVATE_KEY NO se usan en runtime ni en los
# CLIs de NestJS (seed/migrate-imagenes/bootstrap/normalize-descriptions), que
# autentican con ADC igual que el runtime (ver arriba). Solo `migrate:firestore`
# (script raw fuera de NestJS) las consume, conectando origen y destino con un
# service account JSON explícito (p.ej. para copiar datos entre proyectos, no
# para correr el backend local).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@riff-catalogo.iam.gserviceaccount.com
# Pegá el private_key CON los "\n" escapados literales. `migrate:firestore` lo
# normaliza.
FIREBASE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nXXX...\n-----END PRIVATE KEY-----\n'

# =============================================================================
# BOOTSTRAP SUPERADMIN (comando CLI)
# =============================================================================
# Solo se usa UNA vez para crear el primer usuario superadmin (no hay nadie que
# se autentique para usar POST /users). El comando es idempotente.
#   BOOTSTRAP_SUPERADMIN_EMAIL=admin@riff.cl \
#   BOOTSTRAP_SUPERADMIN_PASSWORD='cambiame123' \
#   npm run bootstrap:superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=admin@riff.cl
BOOTSTRAP_SUPERADMIN_PASSWORD='cambiame123'
# Opcional: si no se setea, se usa la parte local del email como nombre.
# BOOTSTRAP_SUPERADMIN_NAME=Administrador

# =============================================================================
# CATALOG REBUILD WEBHOOK
# =============================================================================
# URL del webhook que el backend dispara cuando cambia cualquier entidad pública
# del catálogo (categoría, subcategoría, producto) para que Coolify regenere el
# sitio Astro. Desde catalog-rebuild-flush-scheduler el disparo NO es inmediato:
# los cambios se buferizan en Firestore y Coolify es invocado por el endpoint
# interno de flush (Cloud Scheduler, cada minuto). POST con
# `Authorization: Bearer <TOKEN>` y timeout de 5s. No-op si no está configurado.
# Gestionados como secretos de NestJS en Secret Manager (ops). El token nunca se
# loguea.
CATALOG_REBUILD_WEBHOOK_URL=
CATALOG_REBUILD_WEBHOOK_TOKEN=

# =============================================================================
# CATALOG REBUILD FLUSH (Cloud Scheduler)
# =============================================================================
# Ventana de silencio tras el último cambio del catálogo antes de que el flush
# pueda disparar el webhook (segundos).
CATALOG_REBUILD_SILENCE_SECONDS=60
# Tope de espera de un lote desde su primer cambio antes de disparar aunque no
# haya silencio (segundos). Debe superar la duración del build de Coolify
# (~3-4 min) para que no se solapen deploys.
CATALOG_REBUILD_MAX_WAIT_SECONDS=300
# Vigencia del claim de un flush antes de que otro flush pueda retomarlo
# (segundos); debe superar el timeout del webhook (5s).
CATALOG_REBUILD_CLAIM_TTL_SECONDS=60
# `aud` OIDC esperado del ID token del Cloud Scheduler (URL de Cloud Run del
# entorno). El gate real de autenticación es la verificación app-side de estas
# dos variables (fail-closed si faltan); el rol run.invoker de la SA del
# Scheduler es defensa en profundidad (el servicio corre --allow-unauthenticated).
CATALOG_REBUILD_FLUSH_EXPECTED_AUDIENCE=
# `email` OIDC esperado de la service account del Scheduler
# (p. ej. catalog-rebuild-flusher@<proyecto>.iam.gserviceaccount.com).
CATALOG_REBUILD_FLUSH_EXPECTED_SA=

# =============================================================================
# EMAIL NOTIFICATIONS (Resend — formularios de contacto y cotización)
# =============================================================================
# Los formularios públicos (`/contacto` y `/cotizacion`) persisten el lead en
# Firestore y notifican cada envío a `contacto@somosriff.cl` vía la API HTTP de
# Resend. El adaptador es no-op (con warning) si `RESEND_API_KEY` está vacía, por
# lo que local/dev funcionan sin credenciales. NUNCA se envían correos reales
# desde tests/CI.
#
# La notificación es best-effort: si el envío falla, el backend lo registra en
# logs y responde éxito igualmente (el lead ya quedó persistido).
#
# ANTES DE PRODUCCIÓN: verificar el subdominio `send.somosriff.cl` en Resend
# (añadir los registros DNS SPF/DKIM que Resend indica) para no tocar el DNS
# principal, y usar un remitente de ese subdominio (p. ej.
# notificaciones@send.somosriff.cl).
# Gestionadas como secretos de NestJS en Secret Manager (ops). La key nunca se
# loguea.
RESEND_API_KEY=
# Casilla destino de las notificaciones (default: contacto@somosriff.cl).
CONTACT_TO_EMAIL=contacto@somosriff.cl
# Remitente verificado en Resend (default en código: contacto@somosriff.cl).
# Tras verificar el subdominio, usar un buzón de send.somosriff.cl.
CONTACT_FROM_EMAIL=notificaciones@send.somosriff.cl
