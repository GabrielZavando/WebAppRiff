rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All data access is performed by the backend using the Firebase Admin SDK,
    // which bypasses these rules entirely. Clients (web/admin SDKs) must be fully
    // locked down: no direct client read/write to Firestore is permitted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
